---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();
---

<BaseLayout title="Privacy Policy" description="Privacy policy for JBA Roofing.">
  <PageHero eyebrow="Legal" title="Privacy Policy" />

  <section class="section section--light container container--narrow legal-body">
    <p class="legal-body__notice">
      <strong>[VERIFY WITH CLIENT / LEGAL COUNSEL]</strong>. This policy describes the systems this
      site actually uses today. Have it reviewed by an attorney before relying on it, especially if
      analytics, advertising, or a CRM integration are added later.
    </p>

    <h2 class="h4">Information We Collect</h2>
    <p>
      When you submit a form on this site (such as the Roof Assessment or Contact form), we
      collect the information you provide, including your name, phone number, email address,
      property address, and any details or photos you choose to share about your roofing needs.
    </p>

    <h2 class="h4">How Form Submissions Are Processed</h2>
    <p>
      Forms on this site are submitted through Web3Forms, a third-party form delivery service,
      which forwards your submission to JBA Roofing by email. Web3Forms processes
      the information only to deliver your submission and does not appear to us as a marketing or
      analytics platform. See Web3Forms' own privacy policy for details on how they handle
      submitted data.
    </p>

    <h2 class="h4">How We Use It</h2>
    <p>
      We use this information to respond to your request, schedule an inspection or estimate, and
      communicate with you about the work you've asked about. We do not sell your information to
      third parties.
    </p>

    <h2 class="h4">Hosting</h2>
    <p>
      This site is hosted on Cloudflare Pages. Cloudflare may process standard technical
      information (such as IP address and request data) as part of operating and securing the
      site. See Cloudflare's own privacy policy for details.
    </p>

    <h2 class="h4">Cookies</h2>
    <p>
      This site does not currently use analytics or advertising cookies. A small amount of
      information may be stored in your browser (for example, to remember that you've dismissed
      the cookie notice) which is not shared with anyone. See our <a href="/cookie-policy/" class="link-underline">Cookie Policy</a> for details.
    </p>

    <h2 class="h4">Contact Us</h2>
    <p>
      Questions about this policy can be sent to <a href={`mailto:${settings.email}`}>Email Us</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .legal-body { padding-block: var(--space-6); }
  .legal-body h2 { margin-top: var(--space-6); margin-bottom: var(--space-2); }
  .legal-body p { line-height: var(--leading-normal); margin-bottom: var(--space-3); }
  .legal-body__notice {
    padding: var(--space-4);
    border: 1px dashed var(--color-border);
    background: var(--color-bg-alt);
    margin-bottom: var(--space-6);
  }
</style>
