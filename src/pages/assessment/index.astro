---
import BaseLayout from '@layouts/BaseLayout.astro';
import AssessmentForm from '@components/forms/AssessmentForm.astro';
---

<BaseLayout
  title="Free Roof Assessment"
  description="Start a free roof assessment — tell us what's going on and get a clear recommendation, repair or replace."
  hideStickyCta
>
  <section class="section--light assessment">
    <div class="container container--narrow">
      <h1 class="eyebrow assessment__heading">Free Roof Assessment</h1>
      <AssessmentForm />
    </div>
  </section>
</BaseLayout>

<style>
  .assessment {
    padding-block: var(--space-7) var(--space-9);
    background: var(--color-bg);
    color: var(--color-text);
    min-height: 100vh;
  }
  .assessment__heading { margin-bottom: var(--space-6); }
</style>
