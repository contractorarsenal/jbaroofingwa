---
import BaseLayout from '@layouts/BaseLayout.astro';
import AssessmentForm from '@components/forms/AssessmentForm.astro';
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();
---

<BaseLayout title="Contact" description={`Contact ${settings.businessName}. Call, email, or start a free roof estimate.`}>
  <section class="section contact-page">
    <div class="container contact-page__layout" data-reveal-group>
      <div class="contact-page__left" data-reveal="up">
        <p class="eyebrow eyebrow--inverse">Contact JBA</p>
        <h1 class="h2 contact-page__heading">Need Help With <span class="accent-text">Your Roof?</span></h1>
        <p class="text-muted contact-page__intro">
          Call, email, or start a free estimate below and tell us what's going on.
        </p>

        <div class="contact-page__actions">
          <a href={`tel:${settings.primaryPhone}`} class="btn btn--primary" data-analytics-event="phone_click" data-analytics-location="contact_page">
            Call Now
          </a>
          <a href={`mailto:${settings.email}`} class="btn btn--outline" data-analytics-event="email_click" data-analytics-location="contact_page">
            Email Us
          </a>
        </div>

        <div class="contact-page__areas">
          <p class="contact-page__areas-label">Service Areas</p>
          <ul>
            <li>King County</li>
            <li>Snohomish County</li>
            <li>Skagit County</li>
          </ul>
        </div>

        {settings.emergencyAvailability.verified && settings.emergencyAvailability.value && (
          <p class="contact-page__hours">{settings.emergencyAvailability.value}</p>
        )}
      </div>

      <div class="contact-page__right" data-reveal="up">
        <p class="eyebrow">Free Estimate</p>
        <h2 class="h3 contact-page__form-heading">Get A <span class="accent-text">Free Estimate</span></h2>
        <p class="text-muted contact-page__form-sub">
          Tell us what's happening with your roof and we'll help you figure out the next step.
        </p>

        <AssessmentForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    background: var(--color-dark-charcoal);
    color: var(--color-text-inverse);
    padding-block: var(--space-7);
  }
  .contact-page__layout {
    display: grid;
    gap: var(--space-5);
    max-width: 1180px;
  }
  .contact-page__heading { margin-top: var(--space-2); margin-bottom: var(--space-3); }
  .contact-page__intro { max-width: 42ch; margin-bottom: var(--space-5); }

  .contact-page__left,
  .contact-page__right {
    min-width: 0;
    background: var(--color-charcoal);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .contact-page__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .contact-page__areas {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .contact-page__areas-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .contact-page__areas ul { display: flex; flex-direction: column; gap: 0.35em; }
  .contact-page__areas li { color: var(--color-text-inverse-muted); font-weight: 600; }

  .contact-page__hours {
    margin-top: var(--space-4);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
  }

  .contact-page__form-heading { margin-top: var(--space-2); }
  .contact-page__form-sub { margin-block: var(--space-2) var(--space-5); max-width: 46ch; }

  /* The AssessmentForm's own inputs/option-cards assume a light section
     ambient background, this card is dark, so give its form controls their
     own explicit light surfaces rather than inheriting page-level defaults. */
  .contact-page__right :global(.step__zip-input),
  .contact-page__right :global(.option-card),
  .contact-page__right :global(.form-field input),
  .contact-page__right :global(.form-field textarea) {
    background: var(--color-white);
    color: var(--color-text);
  }
  .contact-page__right :global(.step__title) { color: var(--color-text-inverse); }
  .contact-page__right :global(.step__sub),
  .contact-page__right :global(.step__sub-question),
  .contact-page__right :global(.form-field) { color: var(--color-text-inverse-muted); }
  .contact-page__right :global(.step--confirm h2),
  .contact-page__right :global(.step--error h2) { color: var(--color-text-inverse); }
  .contact-page__right :global(.step--confirm p),
  .contact-page__right :global(.step--error p) { color: var(--color-text-inverse-muted); }

  @media (min-width: 960px) {
    .contact-page__layout { grid-template-columns: 42fr 58fr; gap: var(--space-6); align-items: start; }
  }
</style>
