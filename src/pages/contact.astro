---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/forms/ContactForm.astro';
import Button from '@components/ui/Button.astro';
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();
---

<BaseLayout title="Contact" description={`Contact ${settings.businessName}. Call, email, or send us the details below.`}>
  <section class="contact-intro" data-nav-theme="dark">
    <div class="container container--narrow">
      <p class="eyebrow eyebrow--inverse">Contact JBA</p>
      <h1 class="h2 contact-intro__heading">Need Help With <span class="accent-text">Your Roof?</span></h1>
      <p class="text-muted contact-intro__text">
        Call, email, or send us the details below and tell us what's going on.
      </p>

      <div class="contact-intro__actions">
        <a href={`tel:${settings.primaryPhone}`} class="btn btn--primary" data-analytics-event="call_click" data-analytics-location="contact_page">
          Call Now
        </a>
        <a href={`mailto:${settings.email}`} class="btn btn--outline" data-analytics-event="email_click" data-analytics-location="contact_page">
          Email Us
        </a>
      </div>

      <ul class="contact-intro__areas">
        <li>King County</li>
        <li>Snohomish County</li>
        <li>Skagit County</li>
      </ul>

      {settings.emergencyAvailability.verified && settings.emergencyAvailability.value && (
        <p class="contact-intro__hours">{settings.emergencyAvailability.value}</p>
      )}
    </div>
  </section>

  <section class="section section--white contact-form-section" data-nav-theme="light">
    <div class="container container--narrow">
      <p class="eyebrow eyebrow--center">Get In Touch</p>
      <h2 class="h3 contact-form-section__heading">Send Us A Message</h2>
      <ContactForm />
    </div>
  </section>

  <section class="section section--tight section--off-white book-cta" data-nav-theme="light">
    <div class="container container--narrow book-cta__inner">
      <div>
        <p class="eyebrow">Looking To Book A Roof Assessment?</p>
        <p class="text-muted">Our guided assessment walks you through what you need and gets you a free estimate.</p>
      </div>
      <Button href="/assessment/" variant="outline">Book an Appointment</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-intro {
    background: var(--color-dark-charcoal);
    color: var(--color-text-inverse);
    padding-block: var(--space-7);
    text-align: center;
  }
  .contact-intro__heading { margin-top: var(--space-2); margin-bottom: var(--space-3); }
  .contact-intro__text { max-width: 46ch; margin-inline: auto; }
  .contact-intro__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .contact-intro__areas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-weight: 700;
    color: var(--color-text-inverse-muted);
  }
  .contact-intro__hours {
    margin-top: var(--space-3);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
  }

  .contact-form-section__heading { text-align: center; margin-top: var(--space-2); margin-bottom: var(--space-6); }

  .book-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .book-cta__inner p.text-muted { margin-top: var(--space-1); max-width: 48ch; }
  @media (min-width: 640px) {
    .book-cta__inner { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>
