---
import BaseLayout from '@layouts/BaseLayout.astro';
import AssessmentForm from '@components/forms/AssessmentForm.astro';
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();
---

<BaseLayout title="Contact" description={`Contact ${settings.businessName}. Call, email, or start a free roof estimate.`}>
  <section class="contact-intro" data-nav-theme="dark">
    <div class="container container--narrow">
      <p class="eyebrow eyebrow--inverse">Contact JBA</p>
      <h1 class="h2 contact-intro__heading">Need Help With <span class="accent-text">Your Roof?</span></h1>
      <p class="text-muted contact-intro__text">
        Call, email, or start a free estimate below and tell us what's going on.
      </p>

      <div class="contact-intro__actions">
        <a href={`tel:${settings.primaryPhone}`} class="btn btn--primary" data-analytics-event="phone_click" data-analytics-location="contact_page">
          Call Now
        </a>
        <a href={`mailto:${settings.email}`} class="btn btn--outline" data-analytics-event="email_click" data-analytics-location="contact_page">
          Email Us
        </a>
      </div>

      <ul class="contact-intro__areas">
        <li>King County</li>
        <li>Snohomish County</li>
        <li>Skagit County</li>
      </ul>

      {settings.emergencyAvailability.verified && settings.emergencyAvailability.value && (
        <p class="contact-intro__hours">{settings.emergencyAvailability.value}</p>
      )}
    </div>
  </section>

  <section class="section--light assessment">
    <div class="container container--narrow">
      <p class="eyebrow assessment__eyebrow">Free Estimate</p>
      <h2 class="h3 assessment__heading">Get A <span class="accent-text">Free Estimate</span></h2>
      <p class="text-muted assessment__sub">
        Tell us what's happening with your roof and we'll help you figure out the next step.
      </p>
      <AssessmentForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-intro {
    background: var(--color-dark-charcoal);
    color: var(--color-text-inverse);
    padding-block: var(--space-7);
    text-align: center;
  }
  .contact-intro__heading { margin-top: var(--space-2); margin-bottom: var(--space-3); }
  .contact-intro__text { max-width: 46ch; margin-inline: auto; }
  .contact-intro__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .contact-intro__areas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-weight: 700;
    color: var(--color-text-inverse-muted);
  }
  .contact-intro__hours {
    margin-top: var(--space-3);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
  }

  /* The form section below reuses the exact same section/container/heading
     structure as /assessment/, so the two pages are guaranteed to render
     the AssessmentForm at identical size, no separate CSS system. */
  .assessment {
    padding-block: var(--space-7) var(--space-9);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .assessment__eyebrow { justify-content: center; }
  .assessment__heading { text-align: center; margin-top: var(--space-2); }
  .assessment__sub { text-align: center; max-width: 46ch; margin: var(--space-3) auto var(--space-6); }
</style>
