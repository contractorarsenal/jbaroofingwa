---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import Breadcrumb from '@components/global/Breadcrumb.astro';
import Process from '@components/sections/Process.astro';
import ProblemSelector from '@components/sections/ProblemSelector.astro';
import RepairVsReplace from '@components/sections/RepairVsReplace.astro';
import MaintenanceTeaser from '@components/sections/MaintenanceTeaser.astro';
import ProjectCard from '@components/projects/ProjectCard.astro';
import InfoCardGrid from '@components/ui/InfoCardGrid.astro';
import ComparisonPanel from '@components/ui/ComparisonPanel.astro';
import Button from '@components/ui/Button.astro';
import FaqList from '@components/faqs/FaqList.astro';
import ServiceAreasCTA from '@components/sections/ServiceAreasCTA.astro';
import FinalCTA from '@components/sections/FinalCTA.astro';
import GafCredential from '@components/sections/GafCredential.astro';
import RoofTipVideo from '@components/media/RoofTipVideo.astro';
import {
  getPublishedServices,
  getProjectsForService,
  getFaqsForService,
  getReviewsForService,
} from '@lib/content';
import { buildServiceSchema, buildFaqSchema, buildBreadcrumbSchema } from '@lib/schema';
import { getGlobalSettings } from '@lib/content';
import ReviewCard from '@components/reviews/ReviewCard.astro';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const services = await getPublishedServices();
  return services.map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

const settings = await getGlobalSettings();
const siteUrl = Astro.site?.toString() ?? 'https://jbaroofpro.com';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Roof Replacement specifically connects the verified GAF credential to a
// real customer review that names GAF products, per the trust/proof pass.
const ajeetReview = service.id === 'roof-replacement' ? await getEntry('reviews', 'ajeet-singh') : undefined;

// Roof Inspection gets the one recorded video that's actually about
// inspecting an aging roof, integrated right after the inspection
// checklist rather than tacked on at the bottom of the page.
const inspectionVideo = service.id === 'roof-inspection' ? await getEntry('videos', 'what-an-aging-roof-can-hide') : undefined;

// Roof Maintenance and Roof Cleaning both get the rainy-season prep video
// (same underlying clip), each with its own framing: Maintenance treats it
// as a general "don't wait for a problem" prompt, Cleaning ties it
// specifically to moss/debris buildup before wet weather sets in.
const maintenanceVideo =
  service.id === 'roof-maintenance' || service.id === 'roof-cleaning'
    ? await getEntry('videos', 'beat-the-rain')
    : undefined;

const [projects, faqs, reviewsRaw] = await Promise.all([
  getProjectsForService(service.id),
  getFaqsForService(service.id),
  getReviewsForService(service.id),
]);
// Featured reviews first, so a deliberately curated set surfaces instead of
// whichever review happens to sort first alphabetically by filename. Ajeet's
// review is excluded here when it's already shown in the GAF credential
// section above, so the same reviewer doesn't appear twice on one page.
const reviews = reviewsRaw
  .filter((r) => r.id !== ajeetReview?.id)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const serviceSchema = buildServiceSchema({
  serviceName: data.schemaServiceName ?? data.title,
  description: data.seo.description ?? data.shortDescription,
  siteUrl,
  pageUrl,
  areaServed: [settings.primaryServiceArea, ...settings.secondaryServiceAreas],
  providerName: settings.businessName,
});

const faqSchema = buildFaqSchema(faqs.map((f) => ({ question: f.data.question, answer: f.data.answer })));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Roof Services', url: new URL('/services/', siteUrl).toString() },
  { name: data.title, url: pageUrl },
]);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Roof Services', href: '/services/' },
  { label: data.title },
];

const midEducation = data.educationSections.slice(0, 1);
const restEducation = data.educationSections.slice(1);
---

<BaseLayout
  title={data.seo.title ?? data.title}
  description={data.seo.description ?? data.shortDescription}
  ogImage={data.seo.ogImage}
  noindex={data.seo.noindex}
  jsonLd={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <Breadcrumb items={breadcrumbItems} />
  <PageHero
    eyebrow={data.heroEyebrow}
    title={data.heroTitle}
    description={data.heroDescription}
    image={data.heroImage}
    primaryCta={data.primaryCta}
    secondaryCta={data.secondaryCta}
    tone={data.journey === 'repair' ? 'urgent' : 'default'}
  />

  {(data.overviewText || data.quickFacts.length > 0) && (
    <section class="section section--white" data-nav-theme="light">
      <div class="container split">
        <div>
          {data.overviewText && (
            <>
              <p class="eyebrow">Overview</p>
              <h2 class="h2">What Is {data.title}?</h2>
              <p class="text-muted service-overview__text">{data.overviewText}</p>
            </>
          )}
        </div>
        {data.quickFacts.length > 0 && <InfoCardGrid items={data.quickFacts} columns={1} />}
      </div>
    </section>
  )}

  {(data.problemStatement || data.problemsSolved.length > 0) && (
    <section class="section section--off-white" data-nav-theme="light">
      <div class="container">
        <p class="eyebrow">Signs To Watch For</p>
        <h2 class="h2">{data.problemHeading ?? 'What should you watch for?'}</h2>
        {data.problemStatement && <p class="text-muted service-signs__intro">{data.problemStatement}</p>}
        {data.problemsSolved.length > 0 && (
          <div class="service-signs__grid">
            <InfoCardGrid items={data.problemsSolved.map((s) => ({ title: s }))} columns={2} />
          </div>
        )}
      </div>
    </section>
  )}

  {data.benefits.length > 0 && (
    <section class="section section--charcoal" data-nav-theme="dark">
      <div class="container">
        <p class="eyebrow eyebrow--inverse">{data.benefitsEyebrow ?? 'What You Get'}</p>
        <h2 class="h2">{data.benefitsHeading ?? 'Why work with JBA on this.'}</h2>
        <div class="service-benefits">
          <InfoCardGrid items={data.benefits} tone="dark" columns={3} />
        </div>
      </div>
    </section>
  )}

  {data.process.length > 0 && (
    <Process steps={data.process} heading={data.processHeading ?? 'How it works'} eyebrow={data.processEyebrow ?? 'Process'} />
  )}

  {data.journey === 'repair' && <ProblemSelector />}
  {data.journey === 'replacement' && <RepairVsReplace />}
  {data.journey === 'maintenance' && service.id !== 'roof-maintenance' && (
    <MaintenanceTeaser image="/images/projects/project-06-aging-roof-replacement/before.jpg" />
  )}

  {ajeetReview?.data.published && (
    <GafCredential
      compact
      eyebrow="Why GAF Master Elite® Status Matters"
      heading="Another factor to weigh when comparing roofing companies."
      body="Manufacturer certification gives homeowners another factor to consider when comparing roof replacement companies and roofing systems. Qualifying GAF roofing systems installed by eligible contractors may have access to enhanced GAF warranty options."
      badgeMaxWidth={160}
      badgeMaxWidthMobile={130}
    >
      <div class="gaf-review-slot">
        <p class="gaf-review-slot__label">Real Customer Experience</p>
        <ReviewCard review={ajeetReview} />
      </div>
    </GafCredential>
  )}

  {midEducation.map((section) => (
    <section class:list={['section', section.tone === 'dark' ? 'section--dark-charcoal' : 'section--white']} data-nav-theme={section.tone}>
      <div class="container longform">
        {section.eyebrow && <p class:list={['eyebrow', section.tone === 'dark' && 'eyebrow--inverse']}>{section.eyebrow}</p>}
        <h2 class="h2 longform__heading">{section.heading}</h2>
        {section.intro && <p class="text-muted longform__text">{section.intro}</p>}
        {section.paragraphs.map((p) => <p class="text-muted longform__text">{p}</p>)}
        {section.items.length > 0 && <InfoCardGrid items={section.items} tone={section.tone} columns={section.items.length >= 6 ? 4 : 2} />}
      </div>
    </section>
  ))}

  {inspectionVideo?.data.published && (
    <section class="section section--off-white" data-nav-theme="light">
      <div class="container split">
        <div data-reveal="image">
          <RoofTipVideo
            src={inspectionVideo.data.videoUrl}
            poster={inspectionVideo.data.poster}
            title={inspectionVideo.data.title}
            topic={inspectionVideo.data.topic}
            preload="none"
            showDetails={false}
          />
        </div>
        <div>
          <p class="eyebrow" data-reveal="up">Roofing Tip</p>
          <h2 class="h2" data-reveal="up">Can You Tell Your Roof's Condition From The Ground?</h2>
          <p class="text-muted service-overview__text" data-reveal="up">
            Not always. JBA's inspection process gives homeowners a closer
            look at roof condition and helps identify visible signs of wear
            before they turn into larger problems.
          </p>
          <div data-reveal="up">
            <Button href="/assessment/?need=inspection" analyticsEvent="estimate_cta_click" analyticsLocation="inspection_video" data-analytics-intent="inspection">
              Schedule An Inspection
            </Button>
          </div>
        </div>
      </div>
    </section>
  )}

  {maintenanceVideo?.data.published && (
    <section class="section section--off-white" data-nav-theme="light">
      <div class="container split">
        <div data-reveal="image">
          <RoofTipVideo
            src={maintenanceVideo.data.videoUrl}
            poster={maintenanceVideo.data.poster}
            title={maintenanceVideo.data.title}
            topic={maintenanceVideo.data.topic}
            preload="none"
            showDetails={false}
          />
        </div>
        <div>
          <p class="eyebrow" data-reveal="up">Before The Rain</p>
          <h2 class="h2" data-reveal="up">
            {service.id === 'roof-cleaning'
              ? 'Why Check Your Roof Before The Rainy Season?'
              : "Check Your Roof Before Washington Weather Does."}
          </h2>
          {service.id === 'roof-cleaning' ? (
            <p class="text-muted service-overview__text" data-reveal="up">
              Moss and debris that build up over the dry months hold even
              more water once the rain starts, which is exactly when a
              small amount of buildup turns into a bigger problem. Clearing
              it beforehand gives the roof a clean start heading into wet
              weather.
            </p>
          ) : (
            <p class="text-muted service-overview__text" data-reveal="up">{maintenanceVideo.data.shortDescription}</p>
          )}
          <div data-reveal="up">
            <Button
              href="/assessment/?need=maintenance"
              analyticsEvent="estimate_cta_click"
              analyticsLocation="maintenance_video"
              data-analytics-intent={service.id === 'roof-cleaning' ? 'cleaning' : 'maintenance'}
            >
              {service.id === 'roof-cleaning' ? 'Schedule Roof Cleaning' : 'Schedule Roof Maintenance'}
            </Button>
          </div>
        </div>
      </div>
    </section>
  )}

  {data.comparison && (
    <section class="section section--off-white" data-nav-theme="light">
      <div class="container container--narrow">
        <p class="eyebrow">Compare Your Options</p>
        <h2 class="h2 longform__heading">{data.comparison.heading ?? `${data.comparison.leftLabel} vs. ${data.comparison.rightLabel}`}</h2>
        {data.comparison.directAnswer && <p class="text-muted longform__text">{data.comparison.directAnswer}</p>}
        <ComparisonPanel leftLabel={data.comparison.leftLabel} rightLabel={data.comparison.rightLabel} rows={data.comparison.rows} />
        {data.comparison.linkHref && data.comparison.linkText && (
          <p class="longform__text">
            <a href={data.comparison.linkHref} class="link-underline">{data.comparison.linkText}</a>
          </p>
        )}
      </div>
    </section>
  )}

  {restEducation.map((section, i) => (
    <section class:list={['section', section.tone === 'dark' ? 'section--dark-charcoal' : i % 2 === 0 ? 'section--white' : 'section--off-white']} data-nav-theme={section.tone}>
      <div class="container longform">
        {section.eyebrow && <p class:list={['eyebrow', section.tone === 'dark' && 'eyebrow--inverse']}>{section.eyebrow}</p>}
        <h2 class="h2 longform__heading">{section.heading}</h2>
        {section.intro && <p class="text-muted longform__text">{section.intro}</p>}
        {section.paragraphs.map((p) => <p class="text-muted longform__text">{p}</p>)}
        {section.items.length > 0 && <InfoCardGrid items={section.items} tone={section.tone} columns={section.items.length >= 6 ? 4 : 2} />}
      </div>
    </section>
  ))}

  {!!service.body?.trim() && (
    <section class="section container container--narrow service-body">
      <Content />
    </section>
  )}

  <section class="section section--charcoal service-work" data-nav-theme="dark" data-nav-section="work">
    <div class="container">
      <div class="service-work__header" data-reveal="up">
        <div>
          <p class="eyebrow eyebrow--inverse">Real JBA Work</p>
          <h2 class="h2">See This Service <span class="accent-text">In Action.</span></h2>
        </div>
        <Button href="/projects/" variant="outline">View All Work</Button>
      </div>

      {projects.length > 0 ? (
        <div class="grid grid--3" data-reveal-group>
          {projects.slice(0, 3).map((project) => <ProjectCard project={project} data-reveal="up" />)}
        </div>
      ) : (
        <p class="text-muted">
          See more of our completed roofing projects on the <a href="/projects/" class="link-underline">Our Work</a> page.
        </p>
      )}
    </div>
  </section>

  {data.relatedServiceLinks.length > 0 && (
    <section class="section section--tight section--off-white" data-nav-theme="light">
      <div class="container">
        <p class="eyebrow">Related</p>
        <h3 class="h3 related-services__heading">You Might Also Need</h3>
        <ul class="related-services__list">
          {data.relatedServiceLinks.map((link) => (
            <li><a href={link.href} class="link-underline">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {reviews.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <p class="eyebrow">Reviews</p>
        <h2 class="h2">What customers say about {data.title.toLowerCase()}.</h2>
        <div class="grid grid--3">
          {reviews.slice(0, 3).map((review) => <ReviewCard review={review} />)}
        </div>
      </div>
    </section>
  )}

  <FaqList faqs={faqs} heading={data.faqHeading ?? 'Frequently Asked Questions'} />

  <ServiceAreasCTA />

  <FinalCTA />
</BaseLayout>

<style>
  .service-overview__text { margin-top: var(--space-3); max-width: 56ch; }

  .service-signs__intro { max-width: 62ch; margin-top: var(--space-2); }
  .service-signs__grid { margin-top: var(--space-6); }

  .service-benefits { margin-top: var(--space-6); }

  .related-services__heading { margin-top: var(--space-1); }
  .related-services__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-4);
  }

  .service-work__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }
  @media (min-width: 720px) {
    .service-work__header { flex-direction: row; align-items: flex-end; justify-content: space-between; }
  }

  .service-body :global(p) { margin-bottom: var(--space-4); font-size: var(--step-0); line-height: 1.7; }
  .service-body :global(a) { text-decoration: underline; text-decoration-color: var(--color-accent); }

  .gaf-review-slot { margin-top: var(--space-6); max-width: 420px; }
  .gaf-review-slot__label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
    margin-bottom: var(--space-3);
  }
</style>
