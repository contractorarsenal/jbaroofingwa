---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import Process from '@components/sections/Process.astro';
import ProblemSelector from '@components/sections/ProblemSelector.astro';
import RepairVsReplace from '@components/sections/RepairVsReplace.astro';
import MaintenanceTeaser from '@components/sections/MaintenanceTeaser.astro';
import FeaturedWork from '@components/sections/FeaturedWork.astro';
import FaqList from '@components/faqs/FaqList.astro';
import FinalCTA from '@components/sections/FinalCTA.astro';
import {
  getPublishedServices,
  getProjectsForService,
  getFaqsForService,
  getReviewsForService,
} from '@lib/content';
import { buildServiceSchema, buildFaqSchema, buildBreadcrumbSchema } from '@lib/schema';
import { getGlobalSettings } from '@lib/content';
import ReviewCard from '@components/reviews/ReviewCard.astro';

export async function getStaticPaths() {
  const services = await getPublishedServices();
  return services.map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

const settings = await getGlobalSettings();
const siteUrl = Astro.site?.toString() ?? 'https://jbaroofpro.com';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const [projects, faqs, reviews] = await Promise.all([
  getProjectsForService(service.id),
  getFaqsForService(service.id),
  getReviewsForService(service.id),
]);

const serviceSchema = buildServiceSchema({
  serviceName: data.schemaServiceName ?? data.title,
  description: data.seo.description ?? data.shortDescription,
  siteUrl,
  pageUrl,
  areaServed: [settings.primaryServiceArea, ...settings.secondaryServiceAreas],
  providerName: settings.businessName,
});

const faqSchema = buildFaqSchema(faqs.map((f) => ({ question: f.data.question, answer: f.data.answer })));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Services', url: `${siteUrl}/services/` },
  { name: data.title, url: pageUrl },
]);

// Roof Replacement gets a bespoke flow instead of the generic problem/benefit
// template: signs it's time to replace, then how a replacement actually
// happens, then what JBA checks before recommending it — rather than a
// mechanically-repeated "The Problem" block sitting right under the hero.
const isReplacement = service.id === 'roof-replacement';
---

<BaseLayout
  title={data.seo.title ?? data.title}
  description={data.seo.description ?? data.shortDescription}
  ogImage={data.seo.ogImage}
  noindex={data.seo.noindex}
  jsonLd={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <PageHero
    eyebrow={data.heroEyebrow}
    title={data.heroTitle}
    description={data.heroDescription}
    image={data.heroImage}
    primaryCta={data.primaryCta}
    secondaryCta={data.secondaryCta}
    tone={data.journey === 'repair' ? 'urgent' : 'default'}
  />

  {isReplacement ? (
    <>
      {data.problemsSolved.length > 0 && (
        <section class="section container container--narrow service-signs">
          <p class="eyebrow">Is It Time To Replace Your Roof?</p>
          <ul class="service-signs__list">
            {data.problemsSolved.map((sign) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5L12 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {sign}
              </li>
            ))}
          </ul>
        </section>
      )}

      {data.process.length > 0 && <Process steps={data.process} heading="What happens during a roof replacement." eyebrow="The Process" />}

      {data.benefits.length > 0 && (
        <section class="section section--alt">
          <div class="container">
            <p class="eyebrow">What We Check Before Recommending Replacement</p>
            <h2 class="h2">We don't default to the bigger job.</h2>
            <div class="grid grid--3 service-benefits">
              {data.benefits.map((b) => (
                <div class="service-benefit">
                  <h3 class="service-benefit__title">{b.title}</h3>
                  <p class="text-muted">{b.description}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}
    </>
  ) : (
    <>
      {data.problemStatement && (
        <section class="container container--narrow service-problem">
          <p class="eyebrow">{data.problemHeading ?? 'The Problem'}</p>
          <p class="service-problem__text">{data.problemStatement}</p>
        </section>
      )}

      {data.benefits.length > 0 && (
        <section class="section section--alt">
          <div class="container">
            <p class="eyebrow">What You Get</p>
            <h2 class="h2">Why work with JBA on this.</h2>
            <div class="grid grid--3 service-benefits">
              {data.benefits.map((b) => (
                <div class="service-benefit">
                  <h3 class="service-benefit__title">{b.title}</h3>
                  <p class="text-muted">{b.description}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {data.process.length > 0 && <Process steps={data.process} heading="How it works" eyebrow="Process" />}
    </>
  )}

  {data.journey === 'repair' && <ProblemSelector />}
  {data.journey === 'replacement' && <RepairVsReplace />}
  {data.journey === 'maintenance' && <MaintenanceTeaser />}

  {data.educationSections.map((section, i) => (
    <section class:list={['section', i % 2 === 1 && 'section--alt']}>
      <div class="container container--narrow longform">
        <h2 class="h2 longform__heading">{section.heading}</h2>
        {section.intro && <p class="text-muted longform__text">{section.intro}</p>}
        {section.paragraphs.map((p) => <p class="text-muted longform__text">{p}</p>)}
        {section.items.length > 0 && (
          <div class="longform__items">
            {section.items.map((item) => (
              <div class="longform__item">
                <h3 class="longform__item-title">{item.title}</h3>
                <p class="text-muted">{item.description}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <section class="section container container--narrow service-body">
    <Content />
  </section>

  {projects.length > 0 && <FeaturedWork />}

  {reviews.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <p class="eyebrow">Reviews</p>
        <h2 class="h2">What customers say about {data.title.toLowerCase()}.</h2>
        <div class="grid grid--3">
          {reviews.slice(0, 3).map((review) => <ReviewCard review={review} />)}
        </div>
      </div>
    </section>
  )}

  <FaqList faqs={faqs} heading={data.faqHeading ?? 'Frequently Asked Questions'} />

  <section class="section container container--narrow service-areas-link">
    <a href="/service-areas/" class="link-underline">See the areas we serve →</a>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .service-areas-link { padding-block: 0 var(--space-6); font-weight: 700; }

  .service-problem {
    padding-top: var(--space-6);
    padding-bottom: var(--space-2);
  }
  .service-problem__text {
    font-size: var(--step-1);
    line-height: var(--leading-normal);
    margin-top: var(--space-2);
  }
  .service-benefits { margin-top: var(--space-6); }
  .service-benefit__title { font-size: var(--step-1); margin-bottom: var(--space-1); }

  .service-signs {
    padding-top: var(--space-6);
    padding-bottom: var(--space-2);
  }
  .service-signs__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-4);
  }
  .service-signs__list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .service-signs__list svg { color: var(--color-accent-dark); flex-shrink: 0; }
  @media (max-width: 480px) {
    .service-signs__list { grid-template-columns: 1fr; }
  }
  .service-body :global(p) { margin-bottom: var(--space-4); font-size: var(--step-0); }
  .service-body :global(a) { text-decoration: underline; text-decoration-color: var(--color-accent); }
</style>
