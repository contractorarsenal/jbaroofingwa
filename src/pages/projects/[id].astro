---
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import BeforeAfterSlider from '@components/projects/BeforeAfterSlider.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';
import ReviewCard from '@components/reviews/ReviewCard.astro';
import FinalCTA from '@components/sections/FinalCTA.astro';
import { getPublishedProjects } from '@lib/content';
import { buildBreadcrumbSchema } from '@lib/schema';
import { projectImageAlt } from '@lib/project-media';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const siteUrl = Astro.site?.toString() ?? 'https://jbaroofpro.com';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

const service = data.service ? await getEntry(data.service) : undefined;
const review = data.relatedReview ? await getEntry(data.relatedReview) : undefined;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Our Work', url: `${siteUrl}/projects/` },
  { name: data.projectName, url: pageUrl },
]);

const heroImage = data.droneImages[0] ?? data.afterImages[0];

// A during/progress shot (falling back to an after shot) illustrates "What
// This Project Involved" without reusing the hero or before/after pair.
// Not used at all when a project has a richer storyStages narrative instead.
const involvedImage = data.duringImages[0] ?? data.afterImages[0] ?? data.beforeImages[0];

// Everything else (not already used as the hero, before/after pair, the
// "involved" shot, or a story stage) becomes the project gallery, in a
// sensible story order.
const usedInHero = new Set([heroImage].filter(Boolean));
const usedInBeforeAfter = data.storyStages.length
  ? new Set<string>()
  : new Set([data.beforeImages[0], data.afterImages[0]].filter(Boolean));
const usedInInvolved = data.storyStages.length ? new Set<string>() : new Set([involvedImage].filter(Boolean));
const usedInStory = new Set(data.storyStages.map((s) => s.image));
const galleryImages = [...data.beforeImages, ...data.duringImages, ...data.afterImages, ...data.droneImages].filter(
  (src, i, arr) =>
    src &&
    !usedInHero.has(src) &&
    !usedInBeforeAfter.has(src) &&
    !usedInInvolved.has(src) &&
    !usedInStory.has(src) &&
    arr.indexOf(src) === i
);
---

<BaseLayout
  title={data.seo.title ?? data.projectName}
  description={data.seo.description ?? data.projectSummary}
  ogImage={data.seo.ogImage}
  noindex={data.seo.noindex}
  jsonLd={breadcrumbSchema}
>
  <PageHero
    eyebrow={[data.city, service?.data.title].filter(Boolean).join(' · ') || 'Our Work'}
    title={data.projectName}
    description={data.projectSummary}
    image={heroImage}
  />

  <section class="section container container--narrow project-detail">
    <p class="eyebrow">Project Overview</p>
    {data.customerProblem && (
      <div class="project-detail__block" data-reveal="up">
        <h2 class="h4">The Problem</h2>
        <p class="text-muted">{data.customerProblem}</p>
      </div>
    )}
    {data.inspectionFindings && (
      <div class="project-detail__block" data-reveal="up">
        <h2 class="h4">What We Found</h2>
        <p class="text-muted">{data.inspectionFindings}</p>
      </div>
    )}
    {data.solution && (
      <div class="project-detail__block" data-reveal="up">
        <h2 class="h4">The Work</h2>
        <p class="text-muted">{data.solution}</p>
      </div>
    )}

    {(data.roofMaterial || data.roofType || data.manufacturer) && (
      <div class="project-detail__meta">
        {data.roofMaterial && <span class="badge">{data.roofMaterial}</span>}
        {data.roofType && <span class="badge">{data.roofType}</span>}
        {data.manufacturer && <span class="badge">{data.manufacturer}</span>}
      </div>
    )}

    <Content />
  </section>

  {data.storyStages.length > 0 ? (
    data.storyStages.map((stage, i) => (
      <section class="section">
        <div class="container project-split">
          <div class:list={['project-split__art', i % 2 === 1 && 'project-split__art--second']} data-reveal="image">
            <MediaSlot image={stage.image} alt={projectImageAlt(stage.image, stage.heading)} tone="light" variant={((i % 3) + 1) as 1 | 2 | 3} sizes="(min-width: 900px) 50vw, 100vw" />
          </div>
          <div>
            <p class="eyebrow">{stage.heading}</p>
            <p class="text-muted longform__text">{stage.text}</p>
          </div>
        </div>
      </section>
    ))
  ) : (
    <>
      {data.beforeImages[0] && data.afterImages[0] && (
        <section class="section section--alt">
          <div class="container container--narrow" data-reveal="up">
            <p class="eyebrow">Before &amp; After</p>
            <BeforeAfterSlider
              beforeImage={data.beforeImages[0]}
              afterImage={data.afterImages[0]}
              beforeAlt={projectImageAlt(data.beforeImages[0], 'Before')}
              afterAlt={projectImageAlt(data.afterImages[0], 'After')}
            />
          </div>
        </section>
      )}

      {data.whatThisInvolved && (
        <section class="section">
          <div class="container project-split">
            <div class="project-split__art" data-reveal="image">
              <MediaSlot image={involvedImage} alt={projectImageAlt(involvedImage, data.projectName)} tone="light" variant={2} sizes="(min-width: 900px) 50vw, 100vw" />
            </div>
            <div>
              <p class="eyebrow">What This Project Involved</p>
              <p class="text-muted longform__text">{data.whatThisInvolved}</p>
            </div>
          </div>
        </section>
      )}
    </>
  )}

  {data.homeownerTakeaways.length > 0 && (
    <section class="section section--alt">
      <div class="container container--narrow longform">
        <p class="eyebrow">What Homeowners Can Learn From This Project</p>
        <ul class="longform__list">
          {data.homeownerTakeaways.map((item) => (
            <li>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5L12 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {data.educationSections.map((section, i) => (
    <section class:list={['section', i % 2 === 1 && 'section--alt']}>
      <div class="container container--narrow longform">
        <p class="eyebrow">Service Education</p>
        <h2 class="h2 longform__heading">{section.heading}</h2>
        {section.intro && <p class="text-muted longform__text">{section.intro}</p>}
        {section.paragraphs.map((p) => <p class="text-muted longform__text">{p}</p>)}
        {section.items.length > 0 && (
          <div class="longform__items">
            {section.items.map((item) => (
              <div class="longform__item">
                <h3 class="longform__item-title">{item.title}</h3>
                <p class="text-muted">{item.description}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  {data.watchFor.length > 0 && (
    <section class="section section--alt">
      <div class="container container--narrow longform">
        <p class="eyebrow">What To Watch For</p>
        <ul class="longform__list">
          {data.watchFor.map((item) => (
            <li>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5L12 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {galleryImages.length > 0 && (
    <section class="section section--charcoal">
      <div class="container">
        <p class="eyebrow eyebrow--inverse">Project Gallery</p>
        <div class="project-gallery" data-reveal-group>
          {galleryImages.map((src) => (
            <div class="project-gallery__item" data-reveal="up">
              <MediaSlot image={src} alt={projectImageAlt(src, data.projectName)} tone="dark" sizes="(min-width: 900px) 30vw, 90vw" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {service && (
    <section class="section">
      <div class="container container--narrow">
        <a href={`/services/${service.id}/`} class="project-related-service" data-analytics-event="service_clicked" data-analytics-location="project_detail_related">
          <span class="eyebrow">Related Service</span>
          <span class="h3 project-related-service__title">{service.data.title} <span class="hover-arrow" aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>
  )}

  {review && (
    <section class="section section--alt">
      <div class="container container--narrow">
        <p class="eyebrow">Customer Review</p>
        <ReviewCard review={review} />
      </div>
    </section>
  )}

  {next && next.id !== project.id && (
    <section class="section project-next">
      <div class="container">
        <p class="eyebrow project-next__eyebrow">Next Project</p>
        <a href={`/projects/${next.id}/`} class="project-next__card" data-analytics-event="project_opened" data-analytics-location="project_detail_next">
          <div class="project-next__media">
            <MediaSlot image={next.data.afterImages[0] ?? next.data.droneImages[0]} alt="" tone="light" sizes="120px" />
          </div>
          <div class="project-next__body">
            <span class="project-next__title">{next.data.projectName}</span>
            {next.data.roofMaterial && <span class="text-muted project-next__meta">{next.data.roofMaterial}</span>}
          </div>
          <span class="project-next__cta">View Project <span class="hover-arrow" aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>
  )}

  <FinalCTA />
</BaseLayout>

<style>
  .project-detail__block { margin-bottom: var(--space-5); }
  .project-detail__meta { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); }

  /* Split section ("What This Project Involved"): standardized image | copy
     rhythm, image and text each roughly half width at desktop. */
  .project-split {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .project-split__art {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .project-split { grid-template-columns: 1fr 1fr; }
    .project-split__art--second { order: 2; }
  }

  .project-related-service { display: flex; flex-direction: column; gap: var(--space-2); }
  .project-related-service__title { display: inline-flex; align-items: center; gap: 0.4em; }

  .project-gallery {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .project-gallery__item {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border-dark);
  }
  .project-gallery__item :global(img) { transition: transform 500ms var(--ease-out); }
  .project-gallery__item:hover :global(img) { transform: scale(1.035); }

  /* Compact "Next Project" card — a small link row, not a full-bleed banner. */
  .project-next { padding-block: var(--space-6); }
  .project-next__eyebrow { margin-bottom: var(--space-3); }
  .project-next__card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: 560px;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-base) var(--ease-out);
  }
  .project-next__card:hover { border-color: var(--color-accent); }
  .project-next__media {
    flex-shrink: 0;
    width: 72px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .project-next__body { display: flex; flex-direction: column; gap: 0.2em; min-width: 0; flex: 1; }
  .project-next__title { font-weight: 700; font-size: var(--step-0); }
  .project-next__meta { font-size: 0.8rem; }
  .project-next__cta { flex-shrink: 0; font-size: 0.8125rem; font-weight: 700; color: var(--color-accent-dark); white-space: nowrap; }

  @media (min-width: 720px) {
    .project-gallery { grid-template-columns: repeat(3, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-gallery__item :global(img) { transition: none; }
  }
</style>
