---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';
import GafCredential from '@components/sections/GafCredential.astro';
import ReviewCard from '@components/reviews/ReviewCard.astro';
import RoofTipVideo from '@components/media/RoofTipVideo.astro';
import FinalCTA from '@components/sections/FinalCTA.astro';
import { getPublishedTeam, getGlobalSettings } from '@lib/content';
import { getEntry, getCollection } from 'astro:content';

const team = await getPublishedTeam();
const settings = await getGlobalSettings();

const insuranceOnly = settings.insuranceBonded.verified && settings.insuranceBonded.value;

const [project02, project05, project06, reviewPrakash, reviewThao, reviewJoe, reviewSusan, videosRaw] = await Promise.all([
  getEntry('projects', 'project-02-metal-roof'),
  getEntry('projects', 'project-05-shingle-installation'),
  getEntry('projects', 'project-06-aging-roof-replacement'),
  getEntry('reviews', 'prakash-karuppusamy'),
  getEntry('reviews', 'thao-luanglath'),
  getEntry('reviews', 'joe-hansen'),
  getEntry('reviews', 'susan-malin'),
  getCollection('videos', ({ data }) => data.published),
]);
const aboutReviews = [reviewPrakash, reviewThao, reviewJoe, reviewSusan].filter(
  (r): r is NonNullable<typeof r> => Boolean(r?.data.published)
);
const videos = videosRaw.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="About JBA Roofing | Western Washington Roofing Contractor"
  description="JBA Roofing is a GAF Master Elite roofing contractor serving King, Snohomish, and Skagit counties, Washington."
>
  <PageHero
    eyebrow="About JBA"
    title="Roofing, run the way we'd want it run on our own house."
    description="We're a Washington-based roofing company focused on high-quality roofing systems, craftsmanship, and long-term protection for homeowners across King, Snohomish, and Skagit counties."
    image={project02?.data.afterImages[0]}
  />

  <section class="section" data-nav-theme="light">
    <div class="container about-split">
      <div class="about-split__art" data-reveal="image">
        <MediaSlot image={project06?.data.afterImages[0]} alt="Completed roof replacement, viewed from the ground" tone="light" variant={1} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
      <div>
        <p class="eyebrow" data-reveal="up">Who We Are</p>
        <h2 class="h2" data-reveal="up">A Local Team, Not A Call Center.</h2>
        <p class="text-muted about-split__body" data-reveal="up">
          JBA Roofing is a Washington-based roofing company serving homeowners
          across King, Snohomish, and Skagit counties, with roof replacement as
          our primary focus, alongside repair, inspection, cleaning, and
          maintenance.
        </p>
        <ul class="about-intro__facts" data-reveal="up">
          {settings.yearsExperience.verified && settings.yearsExperience.value && <li>{settings.yearsExperience.value} Experience</li>}
          <li>Free Estimates</li>
          {settings.financingVerified && <li>Financing Available</li>}
          {settings.emergencyAvailability.verified && settings.emergencyAvailability.value && <li>{settings.emergencyAvailability.value}</li>}
        </ul>
      </div>
    </div>
  </section>

  <GafCredential
    eyebrow="Certified Roofing"
    heading="GAF Master Elite® Contractor"
    body="GAF Master Elite® is a selective contractor certification. Only about 2% of roofers in North America are invited to become Master Elite contractors."
    badgeMaxWidth={200}
    badgeMaxWidthMobile={150}
  />

  {aboutReviews.length > 0 && (
    <section class="section section--off-white" data-nav-theme="light">
      <div class="container">
        <p class="eyebrow eyebrow--center">What Homeowners Say</p>
        <h2 class="h2 about-reviews__heading">Straight From Recent Customers.</h2>
        <div class="grid grid--2 about-reviews__grid" data-reveal-group>
          {aboutReviews.map((review) => <ReviewCard review={review} data-reveal="up" />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--alt" data-nav-theme="light">
    <div class="container about-split">
      <div>
        <p class="eyebrow" data-reveal="up">How We Approach A Roof</p>
        <h2 class="h2" data-reveal="up">Inspect First, Recommend Second.</h2>
        <p class="text-muted about-split__body" data-reveal="up">
          Our approach is simple: inspect first, document what we find, and
          give you a straight recommendation instead of defaulting to whichever
          job is bigger. If a repair genuinely solves the problem, that's what
          we'll tell you.
        </p>
      </div>
      <div class="about-split__art" data-reveal="image">
        <MediaSlot image={project05?.data.duringImages[0]} alt="Crew installing new shingles during a roofing project" tone="light" variant={2} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  {videos.length > 0 && (
    <section id="roofing-advice" class="section section--black about-videos" data-nav-theme="dark">
      <div class="container">
        <p class="eyebrow eyebrow--inverse eyebrow--center" data-reveal="up">From The Roofer</p>
        <h2 class="h2 about-videos__heading" data-reveal="up">Roofing Advice From JBA</h2>
        <p class="text-muted about-videos__lede" data-reveal="up">
          Straightforward answers to the questions homeowners ask us about
          inspections, aging roofs, and preparing for Washington weather.
        </p>
        <div class="about-videos__grid" data-reveal-group>
          {videos.map((video, i) => (
            <div class="about-videos__item" data-reveal="up">
              <RoofTipVideo
                src={video.data.videoUrl}
                poster={video.data.poster}
                title={video.data.title}
                eyebrow={video.data.eyebrow}
                description={video.data.shortDescription}
                ctaLabel={video.data.ctaLabel}
                ctaHref={video.data.ctaHref}
                preload="none"
                numbered={i + 1}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" data-nav-theme="light">
    <div class="container about-split">
      <div class="about-split__art" data-reveal="image">
        <MediaSlot image={project06?.data.duringImages[1]} alt="Roofing crew mid-installation on an aging roof replacement" tone="light" variant={3} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
      <div>
        <p class="eyebrow" data-reveal="up">What Homeowners Can Expect</p>
        <h2 class="h2" data-reveal="up">Clear Communication, Start To Finish.</h2>
        <p class="text-muted about-split__body" data-reveal="up">
          From the first inspection to the final walkthrough, you'll know what
          we found, what we recommend, and why, before any work begins. No
          pressure toward a bigger job than the one your roof actually needs.
        </p>
      </div>
    </div>
  </section>

  {insuranceOnly && (
    <section class="section section--alt">
      <div class="container">
        <p class="eyebrow">Credentials</p>
        <ul class="about-credentials">
          <li class="badge">{settings.insuranceBonded.value}</li>
        </ul>
      </div>
    </section>
  )}

  {team.length > 0 && (
    <section class="section">
      <div class="container about-team">
        <p class="eyebrow">Team</p>
        <h2 class="h2">Who you'll actually work with.</h2>
        <div class="grid grid--3 about-team__grid">
          {team.map((member) => (
            <div class="team-card">
              <div class="team-card__photo">
                {member.data.photo ? (
                  <img src={member.data.photo} alt={member.data.name} />
                ) : (
                  <MediaSlot tone="light" variant={2} label={`${member.data.name}, photo pending`} />
                )}
              </div>
              <h3 class="team-card__name">{member.data.name}</h3>
              <p class="text-muted">{member.data.role}</p>
              <p class="team-card__bio">{member.data.shortBio}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <FinalCTA />
</BaseLayout>

<style>
  .about-split {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .about-split__art {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .about-split__body { max-width: 52ch; margin-block: var(--space-3) var(--space-2); }
  @media (min-width: 900px) {
    .about-split { grid-template-columns: 1fr 1fr; }
  }

  .about-intro__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .about-intro__facts li {
    font-weight: 700;
    padding: 0.5em 1em;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
  }
  .about-credentials { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .about-reviews__heading { text-align: center; margin-top: var(--space-2); margin-bottom: var(--space-6); }
  .about-reviews__grid { max-width: 900px; margin-inline: auto; }

  .about-videos__heading { text-align: center; margin-top: var(--space-2); }
  .about-videos__lede { text-align: center; max-width: 56ch; margin: var(--space-3) auto var(--space-7); }
  .about-videos__grid {
    display: grid;
    gap: var(--space-6);
    max-width: 420px;
    margin-inline: auto;
  }
  @media (min-width: 720px) {
    .about-videos__grid { grid-template-columns: repeat(2, 1fr); max-width: 760px; }
  }
  @media (min-width: 1024px) {
    .about-videos__grid { grid-template-columns: repeat(3, 1fr); max-width: none; }
  }
  .about-team__grid { margin-top: var(--space-6); }
  .team-card__photo { aspect-ratio: 1; margin-bottom: var(--space-3); border: 1px solid var(--color-border-dark); border-radius: var(--radius-md); overflow: hidden; }
  .team-card__photo img { width: 100%; height: 100%; object-fit: cover; }
  .team-card__name { font-size: var(--step-1); }
  .team-card__bio { margin-top: var(--space-2); }
</style>
