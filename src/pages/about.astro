---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';
import InstagramEmbed from '@components/ui/InstagramEmbed.astro';
import FinalCTA from '@components/sections/FinalCTA.astro';
import { getPublishedTeam, getGlobalSettings } from '@lib/content';
import { getEntry } from 'astro:content';

const team = await getPublishedTeam();
const settings = await getGlobalSettings();

const credentials = [
  settings.credential.verified && settings.credential.name,
  settings.contractorLicense.verified && settings.contractorLicense.value && `WA Contractor License #${settings.contractorLicense.value}`,
  settings.insuranceBonded.verified && 'Licensed & Insured',
].filter(Boolean) as string[];

const [project02, project05, project06] = await Promise.all([
  getEntry('projects', 'project-02-metal-roof'),
  getEntry('projects', 'project-05-shingle-installation'),
  getEntry('projects', 'project-06-aging-roof-replacement'),
]);
---

<BaseLayout
  title="About JBA Roofing"
  description="JBA Roofing is a roofing contractor serving King, Snohomish, and Skagit counties, Washington."
>
  <PageHero
    eyebrow="About JBA"
    title="Roofing, run the way we'd want it run on our own house."
    description="We're a Washington-based roofing company focused on high-quality roofing systems, craftsmanship, and long-term protection for homeowners across King, Snohomish, and Skagit counties."
    image={project02?.data.afterImages[0]}
  />

  <section class="section" data-nav-theme="light">
    <div class="container about-split">
      <div class="about-split__art" data-reveal="image">
        <MediaSlot image={project06?.data.afterImages[0]} alt="Completed roof replacement, viewed from the ground" tone="light" variant={1} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
      <div>
        <p class="eyebrow" data-reveal="up">Who We Are</p>
        <h2 class="h2" data-reveal="up">A Local Team, Not A Call Center.</h2>
        <p class="text-muted about-split__body" data-reveal="up">
          JBA Roofing is a Washington-based roofing company serving homeowners
          across King, Snohomish, and Skagit counties, with roof replacement as
          our primary focus, alongside repair, inspection, cleaning, and
          rejuvenation.
        </p>
        <ul class="about-intro__facts" data-reveal="up">
          {settings.yearsExperience.verified && settings.yearsExperience.value && <li>{settings.yearsExperience.value} Experience</li>}
          <li>Free Estimates</li>
          {settings.financingVerified && <li>Financing Available</li>}
          {settings.emergencyAvailability.verified && settings.emergencyAvailability.value && <li>{settings.emergencyAvailability.value}</li>}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt" data-nav-theme="light">
    <div class="container about-split">
      <div>
        <p class="eyebrow" data-reveal="up">How We Approach A Roof</p>
        <h2 class="h2" data-reveal="up">Inspect First, Recommend Second.</h2>
        <p class="text-muted about-split__body" data-reveal="up">
          Our approach is simple: inspect first, document what we find, and
          give you a straight recommendation instead of defaulting to whichever
          job is bigger. If a repair genuinely solves the problem, that's what
          we'll tell you.
        </p>
      </div>
      <div class="about-split__art" data-reveal="image">
        <MediaSlot image={project05?.data.duringImages[0]} alt="Crew installing new shingles during a roofing project" tone="light" variant={2} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section section--charcoal about-instagram" data-nav-theme="dark">
    <div class="container about-split about-split--ig">
      <div>
        <p class="eyebrow eyebrow--inverse" data-reveal="up">See JBA In Action</p>
        <h2 class="h2" data-reveal="up">Real Work. <span class="accent-text">Real Projects.</span></h2>
        <p class="text-muted about-split__body" data-reveal="up">
          We share completed roofs and job-site photos on Instagram as we
          finish them. Take a look at recent work directly from the source.
        </p>
      </div>
      <div data-reveal="up">
        <InstagramEmbed url="https://www.instagram.com/p/DcubreIjYt5/" />
      </div>
    </div>
  </section>

  <section class="section" data-nav-theme="light">
    <div class="container about-split">
      <div class="about-split__art" data-reveal="image">
        <MediaSlot image={project06?.data.duringImages[1]} alt="Roofing crew mid-installation on an aging roof replacement" tone="light" variant={3} sizes="(min-width: 900px) 50vw, 100vw" />
      </div>
      <div>
        <p class="eyebrow" data-reveal="up">What Homeowners Can Expect</p>
        <h2 class="h2" data-reveal="up">Clear Communication, Start To Finish.</h2>
        <p class="text-muted about-split__body" data-reveal="up">
          From the first inspection to the final walkthrough, you'll know what
          we found, what we recommend, and why, before any work begins. No
          pressure toward a bigger job than the one your roof actually needs.
        </p>
      </div>
    </div>
  </section>

  {credentials.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <p class="eyebrow">Credentials</p>
        <ul class="about-credentials">
          {credentials.map((c) => <li class="badge">{c}</li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container about-team">
      <p class="eyebrow">Team</p>
      <h2 class="h2">Who you'll actually work with.</h2>
      {team.length > 0 ? (
        <div class="grid grid--3 about-team__grid">
          {team.map((member) => (
            <div class="team-card">
              <div class="team-card__photo">
                {member.data.photo ? (
                  <img src={member.data.photo} alt={member.data.name} />
                ) : (
                  <MediaSlot tone="light" variant={2} label={`${member.data.name}, photo pending`} />
                )}
              </div>
              <h3 class="team-card__name">{member.data.name}</h3>
              <p class="text-muted">{member.data.role}</p>
              <p class="team-card__bio">{member.data.shortBio}</p>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-muted about-team__empty">
          Team photos and bios are being added. Check back soon, or ask us
          directly who'll be on your job when you request an assessment.
        </p>
      )}
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .about-split {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .about-split__art {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .about-split__body { max-width: 52ch; margin-block: var(--space-3) var(--space-2); }
  @media (min-width: 900px) {
    .about-split { grid-template-columns: 1fr 1fr; }
    .about-split--ig { grid-template-columns: 2fr 3fr; }
  }

  .about-intro__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .about-intro__facts li {
    font-weight: 700;
    padding: 0.5em 1em;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
  }
  .about-credentials { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .about-team__grid { margin-top: var(--space-6); }
  .about-team__empty { max-width: 60ch; margin-top: var(--space-4); }
  .team-card__photo { aspect-ratio: 1; margin-bottom: var(--space-3); border: 1px solid var(--color-border-dark); border-radius: var(--radius-md); overflow: hidden; }
  .team-card__photo img { width: 100%; height: 100%; object-fit: cover; }
  .team-card__name { font-size: var(--step-1); }
  .team-card__bio { margin-top: var(--space-2); }
</style>
