---
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();

const pillars = [
  {
    title: settings.yearsExperience.verified && settings.yearsExperience.value ? settings.yearsExperience.value : 'Roofing Experience',
    description: 'Roofing experience serving Washington homeowners.',
  },
  {
    title: settings.emergencyAvailability.verified && settings.emergencyAvailability.value ? settings.emergencyAvailability.value : '24-Hour Availability',
    description: 'Available when roofing problems cannot wait.',
  },
  {
    title: 'Free Estimates',
    description: 'Understand the scope before deciding what comes next.',
  },
  {
    title: 'Financing Available',
    description: 'Flexible options for qualifying homeowners.',
  },
  {
    title: 'Local Service',
    description: 'King, Snohomish, and Skagit counties.',
  },
  {
    title: 'Roofing Focused',
    description: 'Replacement, repair, inspections, cleaning, and maintenance.',
  },
];
---

<section class="section section--white why-jba" data-nav-theme="light">
  <div class="container">
    <p class="eyebrow eyebrow--center" data-reveal="up">Why JBA</p>
    <h2 class="h2 why-jba__heading" data-reveal="up">Why Homeowners Choose <span class="accent-text">JBA</span></h2>
    <p class="text-muted why-jba__lede" data-reveal="up">Straightforward reasons homeowners work with us, nothing exaggerated.</p>

    <div class="why-jba__grid" data-reveal="up">
      {pillars.map((pillar, i) => (
        <div class="why-item">
          <span class="why-item__number">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="why-item__title">{pillar.title}</h3>
            <p class="text-muted">{pillar.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-jba__heading { text-align: center; margin-top: var(--space-2); }
  .why-jba__lede { text-align: center; max-width: 56ch; margin: var(--space-3) auto 0; }
  .why-jba__grid {
    display: grid;
    margin-top: var(--space-7);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }
  .why-item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-5);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .why-item__number {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--color-accent);
    line-height: 1;
    flex-shrink: 0;
  }
  .why-item__title {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin-bottom: var(--space-1);
  }

  @media (min-width: 720px) {
    .why-jba__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .why-jba__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
