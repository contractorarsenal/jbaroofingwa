---
import { getGlobalSettings } from '@lib/content';
import { getEntry } from 'astro:content';
import Button from '@components/ui/Button.astro';
import TrustFacts from '@components/ui/TrustFacts.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';

const settings = await getGlobalSettings();
// Real finished-roof aerial from Project 01, the strongest single-image
// composition of the seven project sets, as a full-bleed hero background.
// Falls back to the roof-replacement service's own heroImage, then to
// MediaSlot's branded placeholder, if project content is ever unpublished.
const heroProject = await getEntry('projects', 'project-01-shingle-roof-replacement');
const replacementService = await getEntry('services', 'roof-replacement');
const heroImage = heroProject?.data.droneImages[0] ?? replacementService?.data.heroImage;
---

<section class="hero" data-nav-theme="dark">
  <div class="hero__bg" data-parallax>
    <MediaSlot
      image={heroImage}
      alt="Completed shingle roof viewed from above"
      tone="dark"
      variant={1}
      loading="eager"
      sizes="100vw"
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow eyebrow--inverse hero__anim hero__anim--1">Roofing &amp; Remodeling &middot; Northwest Washington</p>
      <h1 class="h1 hero__headline hero__anim hero__anim--2">A Better Roof Starts With The <span class="accent-text">Right Roofer.</span></h1>
      <p class="hero__sub hero__anim hero__anim--3">
        Roof replacement, repairs, inspections, cleaning, and roof care for
        homeowners across King, Snohomish, and Skagit Counties.
      </p>
      <div class="hero__actions hero__anim hero__anim--4">
        <Button href={settings.primaryCtaDestination} analyticsEvent="quote_started" analyticsLocation="hero_primary">
          Get a Free Estimate
        </Button>
        <Button href={`tel:${settings.primaryPhone}`} variant="outline" analyticsEvent="phone_click" analyticsLocation="hero_secondary">
          Call Now
        </Button>
      </div>
      <div class="hero__trust hero__anim hero__anim--5">
        <TrustFacts tone="dark" />
      </div>
    </div>

    <div class="hero__logo hero__anim hero__anim--media">
      <img src="/images/brand/jba-nav-logo.webp" alt="" width="240" height="240" />
    </div>
  </div>

  <div class="hero__scroll">
    <span class="hero__scroll-line" aria-hidden="true"></span>
    <span>SCROLL</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-black);
    color: var(--color-text-inverse);
    min-height: min(92vh, 860px);
    display: flex;
    align-items: center;
    padding-block: var(--space-8);
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent) 50%, transparent);
    opacity: 0.6;
    z-index: 2;
  }

  .hero__bg {
    position: absolute;
    inset: -20px;
    z-index: 0;
    will-change: transform;
  }
  .hero__bg :global(.media-slot) { width: 100%; height: 100%; min-height: 100%; }
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Strong, deliberately dark, not washed out, the hero must still read
       as black. Darkest over the copy side, still substantial over the
       logo side so the section never looks like a bright photo with text
       on top. */
    background: linear-gradient(115deg, rgba(8, 8, 8, 0.95) 0%, rgba(8, 8, 8, 0.9) 40%, rgba(8, 8, 8, 0.72) 68%, rgba(8, 8, 8, 0.85) 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__bg { transform: none !important; }
  }

  /* entrance sequence, plays once on load, independent of scroll */
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroMediaReveal {
    from { opacity: 0; transform: scale(1.035); }
    to { opacity: 1; transform: scale(1); }
  }
  .hero__anim { animation: heroRise 700ms var(--ease-out) both; }
  .hero__anim--1 { animation-delay: 100ms; }
  .hero__anim--2 { animation-delay: 200ms; }
  .hero__anim--3 { animation-delay: 420ms; }
  .hero__anim--4 { animation-delay: 500ms; }
  .hero__anim--5 { animation-delay: 600ms; }
  .hero__anim--media { animation: heroMediaReveal 950ms var(--ease-out) both; animation-delay: 380ms; }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-6);
    align-items: center;
    width: 100%;
    height: 100%;
  }
  .hero__content { max-width: 600px; }
  .hero__headline {
    margin-top: var(--space-3);
  }
  .hero__sub {
    margin-top: var(--space-4);
    font-size: 1.05rem;
    font-family: var(--font-body);
    color: var(--color-text-inverse-muted);
    max-width: 480px;
    line-height: var(--leading-normal);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .hero__trust {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-dark);
  }

  /* Logo mark: small and centered below the copy on mobile, a proper
     branded element in the right column on desktop, never the size of a
     hero image itself. */
  .hero__logo {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2);
  }
  .hero__logo img {
    width: auto;
    height: auto;
    max-height: 72px;
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.5));
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--space-5);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-text-inverse-muted);
  }
  .hero__scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, var(--color-accent), transparent);
  }

  @media (min-width: 860px) {
    .hero__inner { grid-template-columns: 1.25fr 1fr; }
    .hero__logo { margin-top: 0; }
    .hero__logo img { max-height: 220px; }
    .hero__scroll { display: flex; }
  }
</style>
