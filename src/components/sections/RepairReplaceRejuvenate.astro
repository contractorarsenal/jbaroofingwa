---
/**
 * Homeowners often don't know which of these three they actually need —
 * this section helps them self-identify without making a diagnostic claim,
 * then routes into the assessment funnel for a real answer.
 */
const options = [
  {
    number: '01',
    tag: 'Repair',
    description: 'For isolated damage, leaks, or localized issues.',
    href: '/services/roof-repair/',
    modifier: 'repair',
  },
  {
    number: '02',
    tag: 'Rejuvenate',
    description: 'For roofs that may still have usable life but need preventative treatment.',
    href: '/services/roof-rejuvenation/',
    modifier: 'rejuvenate',
  },
  {
    number: '03',
    tag: 'Replace',
    description: 'For roofs that have reached the point where continued repairs no longer make sense.',
    href: '/services/roof-replacement/',
    modifier: 'replace',
  },
];
---

<section class="section section--black decision" data-nav-theme="dark">
  <div class="decision__motif" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow eyebrow--inverse eyebrow--center" data-reveal="up">Not Sure Where To Start?</p>
    <h2 class="h2 decision__heading" data-reveal="up">What Does Your Roof <span class="accent-text">Actually Need?</span></h2>

    <div class="grid grid--3 decision__grid" data-reveal-group>
      {options.map((option) => (
        <a href={option.href} class="decision-card" data-reveal="up" data-analytics-event="service_clicked" data-analytics-location={`decision_${option.modifier}`}>
          <span class="decision-card__bar" aria-hidden="true"></span>
          <span class="decision-card__number">{option.number}</span>
          <h3 class="decision-card__title">{option.tag}</h3>
          <p class="text-muted decision-card__desc">{option.description}</p>
          <span class="decision-card__arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9h12M11 5l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      ))}
    </div>

    <p class="decision__cta" data-reveal="up">
      Not sure which one applies? <a href="/assessment/?need=inspection" class="link-underline" data-analytics-event="quote_started" data-analytics-location="decision_unsure">Book a Roof Inspection →</a>
    </p>
  </div>
</section>

<style>
  .decision { position: relative; overflow: hidden; }
  .decision__motif {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    background-image: repeating-linear-gradient(135deg, var(--color-accent) 0px, var(--color-accent) 1px, transparent 1px, transparent 46px);
    pointer-events: none;
  }
  .decision > .container { position: relative; z-index: 1; }
  .decision__heading { text-align: center; margin-top: var(--space-2); }
  .decision__grid { margin-top: var(--space-7); }
  .decision-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-5) var(--space-5);
    min-height: 260px;
    background: var(--color-charcoal-raised);
    border: 1.5px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), background-color var(--duration-base) var(--ease-out);
  }
  .decision-card__bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out);
  }
  .decision-card:hover .decision-card__bar { transform: scaleX(1); }
  .decision-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    background: var(--color-charcoal);
  }
  .decision-card__number {
    font-family: var(--font-display);
    font-size: var(--step-5);
    color: var(--color-accent);
    opacity: 0.45;
    line-height: 1;
    transition: opacity var(--duration-base) var(--ease-out);
  }
  .decision-card:hover .decision-card__number { opacity: 0.8; }
  .decision-card__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }
  .decision-card__desc { max-width: 32ch; }
  .decision-card__arrow {
    margin-top: auto;
    display: inline-flex;
    color: var(--color-text-inverse-muted);
    transform: translateX(0);
    transition: transform var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out);
  }
  .decision-card:hover .decision-card__arrow {
    transform: translateX(6px);
    color: var(--color-accent);
  }
  .decision__cta { text-align: center; margin-top: var(--space-6); color: var(--color-text-inverse-muted); }
</style>
