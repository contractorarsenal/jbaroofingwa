---
import { getFeaturedProjects } from '@lib/content';
import ProjectCard from '@components/projects/ProjectCard.astro';
import Button from '@components/ui/Button.astro';

const projects = await getFeaturedProjects(3);
---

<section class="section section--off-white featured-work" data-nav-theme="light" data-nav-section="work">
  <div class="container">
    <div class="featured-work__header" data-reveal="up">
      <div>
        <p class="eyebrow">Our Work</p>
        <h2 class="h2">Our Work Speaks <span class="accent-text">For Itself.</span></h2>
      </div>
      <Button href="/projects/" variant="outline">View All Work</Button>
    </div>

    {projects.length > 0 && (
      <div class="grid grid--3" data-reveal-group>
        {projects.map((project) => <ProjectCard project={project} data-reveal="up" />)}
      </div>
    )}
  </div>
</section>

<style>
  .featured-work__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }
  @media (min-width: 720px) {
    .featured-work__header { flex-direction: row; align-items: flex-end; justify-content: space-between; }
  }
</style>
