---
import { getEntry } from 'astro:content';
import Button from '@components/ui/Button.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';

const service = await getEntry('services', 'roof-replacement');
const featureProject = await getEntry('projects', 'project-06-aging-roof-replacement');
const afterImage = featureProject?.data.afterImages[0] ?? service?.data.heroImage;
const beforeImage = featureProject?.data.beforeImages[0];

const signs = [
  'Repeated leaks',
  'Missing or damaged shingles',
  'Visible wear or curling',
  'An older roofing system',
  'Multiple repairs in the same areas',
  'Interior water damage',
];
---

<section class="section section--black primary-service" data-nav-theme="dark">
  <span class="primary-service__ghost" aria-hidden="true">01</span>
  <div class="container primary-service__layout">
    <div class="primary-service__copy">
      <p class="eyebrow eyebrow--inverse" data-reveal="up">Our #1 Service</p>
      <h2 class="h2" data-reveal="up">When Repairs Aren't Enough, <span class="accent-text">Replace It Right.</span></h2>
      <p class="text-muted primary-service__body" data-reveal="up">
        When repairs are no longer enough, we can replace your roof from tear-off
        through final installation. Free estimates and financing are available
        for qualifying homeowners.
      </p>

      <ul class="primary-service__signs" data-reveal="up">
        <p class="primary-service__signs-label">Signs it may be time:</p>
        {signs.map((sign) => (
          <li>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5L12 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {sign}
          </li>
        ))}
      </ul>

      <div class="primary-service__actions" data-reveal="up">
        <Button href="/assessment/?need=replacement" analyticsEvent="estimate_cta_click" analyticsLocation="primary_service" data-analytics-intent="replacement">
          Get a Free Roof Estimate
        </Button>
        <Button href="/services/roof-replacement/" variant="outline">
          Roof Replacement →
        </Button>
      </div>
    </div>
    <div class="primary-service__art" data-reveal="image">
      <div class="primary-service__art-parallax" data-parallax>
        <MediaSlot image={afterImage} alt="Completed aging roof replacement" tone="dark" variant={3} sizes="(min-width: 900px) 55vw, 100vw" />
      </div>
      {beforeImage && (
        <div class="primary-service__before">
          <span class="primary-service__before-tag">Before</span>
          <MediaSlot image={beforeImage} alt="Very aged roof before replacement" tone="dark" sizes="220px" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .primary-service { position: relative; overflow: hidden; }
  .primary-service__ghost {
    position: absolute;
    top: -0.15em;
    right: var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(8rem, 6rem + 10vw, 16rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-text-inverse);
    opacity: 0.035;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .primary-service__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .primary-service__art {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .primary-service__art-parallax {
    position: absolute;
    inset: -20px;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .primary-service__art-parallax { transform: none !important; }
  }
  .primary-service__before {
    /* mobile: safely inset within the main image's own box (no risk of
       breaching the viewport edge) */
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    width: 110px;
    aspect-ratio: 4 / 3;
    border: 2px solid var(--color-black);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    z-index: 2;
  }
  .primary-service__before-tag {
    position: absolute;
    top: 6px;
    left: 6px;
    z-index: 1;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25em 0.6em;
    background: rgba(8, 8, 8, 0.85);
    color: var(--color-accent);
    border-radius: 3px;
  }
  @media (min-width: 640px) {
    /* wider viewports have enough margin for the thumbnail to genuinely
       poke past the main image's corner without risking overflow */
    .primary-service__before {
      width: 190px;
      left: calc(var(--space-6) * -1);
      bottom: calc(var(--space-6) * -1);
    }
  }
  .primary-service__body { margin-block: var(--space-3) var(--space-5); max-width: 54ch; }
  .primary-service__signs-label { font-weight: 700; margin-bottom: var(--space-2); }
  .primary-service__signs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }
  .primary-service__signs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-inverse-muted);
    font-size: 0.9rem;
  }
  .primary-service__signs svg { color: var(--color-accent); flex-shrink: 0; }
  .primary-service__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  @media (min-width: 900px) {
    .primary-service__layout { grid-template-columns: 1fr 1.2fr; }
    /* the image is now the right-hand column, so the before-thumbnail pokes
       out to the right instead of the left, away from the copy column */
    .primary-service__before {
      left: auto;
      right: calc(var(--space-6) * -1);
    }
    .primary-service__before-tag { left: auto; right: 6px; }
  }
</style>
