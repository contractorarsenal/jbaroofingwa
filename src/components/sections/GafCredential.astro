---
/**
 * The verified GAF Master Elite credential section, reused on the
 * homepage, About, and Roof Replacement pages so the badge/wording/
 * disclaimer never drift out of sync between them.
 *
 * `settings.credential.badgeImage` holds the real, client-supplied GAF
 * Master Elite badge (saved locally, never hotlinked). If that field is
 * ever cleared, this falls back to a text-based "GAF / MASTER ELITE"
 * wordmark badge instead of risking a broken <img>.
 */
import { getGlobalSettings } from '@lib/content';

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  tone?: 'black' | 'charcoal';
  compact?: boolean;
  /** Max badge width in px at desktop widths (mobile is capped separately, see badgeMaxWidthMobile). */
  badgeMaxWidth?: number;
  badgeMaxWidthMobile?: number;
}

const {
  eyebrow = 'GAF Master Elite®',
  heading = 'A credential held by about 2% of roofers in North America.',
  body = "JBA Roofing is a GAF Master Elite® Contractor. Qualifying GAF roofing systems installed by eligible contractors may be eligible for enhanced warranty options, including the Golden Pledge® Limited Warranty.",
  tone = 'charcoal',
  compact = false,
  badgeMaxWidth = 220,
  badgeMaxWidthMobile = 150,
} = Astro.props;

const settings = await getGlobalSettings();
const { credential, contractorLicense } = settings;

const show = credential.verified && credential.name;
const badgeStyle = `--gaf-badge-max: ${badgeMaxWidth}px; --gaf-badge-max-mobile: ${badgeMaxWidthMobile}px;`;
---

{show && (
  <section class:list={['section', compact && 'section--tight', tone === 'black' ? 'section--black' : 'section--charcoal', 'gaf-credential']} data-nav-theme="dark">
    <div class="container split">
      <div class="gaf-credential__badge-wrap" style={badgeStyle}>
        {credential.badgeImage ? (
          <img src={credential.badgeImage} alt="GAF Master Elite Contractor certification" width="445" height="445" class="gaf-credential__badge-img" />
        ) : (
          <div class="gaf-credential__badge" role="img" aria-label="GAF Master Elite Contractor certification">
            <span class="gaf-credential__badge-brand">GAF</span>
            <span class="gaf-credential__badge-tier">Master Elite<sup>®</sup></span>
            <span class="gaf-credential__badge-sub">Certified Contractor</span>
          </div>
        )}
      </div>
      <div>
        <p class="eyebrow eyebrow--inverse">{eyebrow}</p>
        <h2 class="h2">{heading}</h2>
        <p class="text-muted gaf-credential__body">{body}</p>
        <p class="gaf-credential__disclaimer">
          Warranty eligibility, coverage, terms, and restrictions vary by roofing system and products installed. JBA Roofing is an independent contractor and is not an employee or agent of GAF.
        </p>

        <div class="gaf-credential__proof">
          <span class="badge">GAF Master Elite®</span>
          {contractorLicense.verified && contractorLicense.value && (
            <span class="badge">WA License: {contractorLicense.value}</span>
          )}
          {credential.contractorId && (
            <span class="badge">GAF Contractor ID: {credential.contractorId}</span>
          )}
        </div>

        {credential.verificationUrl && (
          <a href={credential.verificationUrl} target="_blank" rel="noopener noreferrer" class="gaf-credential__verify">
            Verify With GAF <span aria-hidden="true">→</span>
          </a>
        )}

        <slot />
      </div>
    </div>
  </section>
)}

<style>
  .gaf-credential__badge-wrap { display: flex; justify-content: center; }
  .gaf-credential__badge-img {
    width: auto;
    height: auto;
    max-width: var(--gaf-badge-max, 220px);
    object-fit: contain;
  }
  .gaf-credential__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2em;
    width: 100%;
    max-width: var(--gaf-badge-max, 220px);
    aspect-ratio: 1;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    padding: var(--space-5);
    text-align: center;
  }
  .gaf-credential__badge-brand {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--color-text-inverse);
    line-height: 1;
  }
  .gaf-credential__badge-tier {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .gaf-credential__badge-sub {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
  }

  .gaf-credential__body { margin-top: var(--space-3); max-width: 56ch; }
  .gaf-credential__disclaimer {
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-inverse-muted);
    max-width: 60ch;
  }
  .gaf-credential__proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .gaf-credential__verify {
    display: inline-block;
    margin-top: var(--space-5);
    font-weight: 700;
    color: var(--color-accent);
  }
  .gaf-credential__verify:hover { text-decoration: underline; }

  @media (max-width: 899px) {
    .gaf-credential__badge, .gaf-credential__badge-img { max-width: var(--gaf-badge-max-mobile, 150px); }
  }
</style>
