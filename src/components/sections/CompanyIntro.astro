---
import { getEntry } from 'astro:content';
import Button from '@components/ui/Button.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';
import TrustFacts from '@components/ui/TrustFacts.astro';

// A crew/work-in-progress shot (not just a finished roof) makes this section
// feel human rather than purely product-photography.
const introProject = await getEntry('projects', 'project-03-water-damage-roof-repair');
const introImage = introProject?.data.duringImages[2]; // crew removing damaged decking
---

<section class="section section--white company-intro" data-nav-theme="light">
  <div class="container company-intro__layout">
    <div class="company-intro__art" data-reveal="image">
      <MediaSlot
        image={introImage}
        alt="JBA crew removing damaged roof decking during repair"
        tone="light"
        variant={2}
        label="JBA Roofing, crew and project photography pending"
        sizes="(min-width: 900px) 50vw, 100vw"
      />
    </div>
    <div>
      <p class="eyebrow" data-reveal="up">JBA Roofing</p>
      <h2 class="h2" data-reveal="up">Roofing Built For <span class="accent-text">Northwest Homes.</span></h2>
      <p class="text-muted company-intro__body" data-reveal="up">
        JBA Roofing is a Washington-based roofing company focused on
        high-quality roofing systems, craftsmanship, and long-term
        protection.
      </p>
      <p class="text-muted company-intro__body" data-reveal="up">
        We serve homeowners across King, Snohomish, and Skagit counties, with
        roof replacement as our primary focus, alongside repair, inspection,
        cleaning, and maintenance.
      </p>

      <div class="company-intro__proof" data-reveal="up">
        <TrustFacts tone="light" compact />
      </div>

      <div class="company-intro__actions">
        <Button href="/about/" variant="outline">About JBA</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .company-intro__layout {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .company-intro__art {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .company-intro__body { margin-bottom: var(--space-3); max-width: 52ch; }
  .company-intro__proof { margin-block: var(--space-6); }
  .company-intro__actions { margin-top: var(--space-2); }

  @media (min-width: 900px) {
    .company-intro__layout { grid-template-columns: 1fr 1fr; }
  }
</style>
