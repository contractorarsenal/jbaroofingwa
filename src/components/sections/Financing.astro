---
import { getGlobalSettings } from '@lib/content';
import Button from '@components/ui/Button.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';

const settings = await getGlobalSettings();
---

{settings.financingVerified && (
  <section id="financing" class="section section--off-white financing" data-nav-theme="light">
    <div class="container financing__layout">
      <div>
        <p class="eyebrow" data-reveal="up">Financing</p>
        <h2 class="h2 financing__heading" data-reveal="up">Financing <span class="accent-text">Available.</span></h2>
        <p class="text-muted financing__body" data-reveal="up">
          A roofing project is a major investment. Financing options are
          available for qualified homeowners.
        </p>
        <div class="financing__actions" data-reveal="up">
          <Button href="/contact/" analyticsEvent="financing_clicked" analyticsLocation="homepage_financing">
            Ask About Financing
          </Button>
          <Button href={settings.primaryCtaDestination} variant="outline">
            Get a Free Estimate
          </Button>
        </div>
      </div>
      <div class="financing__art" data-reveal="image">
        <MediaSlot tone="light" variant={3} label="Financing for roofing projects" />
      </div>
    </div>
  </section>
)}

<style>
  .financing__layout {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .financing__heading { margin-top: var(--space-2); }
  .financing__body { margin-block: var(--space-3) var(--space-6); max-width: 46ch; }
  .financing__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .financing__art {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .financing__layout { grid-template-columns: 1fr 1fr; }
  }
</style>
