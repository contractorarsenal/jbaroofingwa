---
import { getGlobalSettings } from '@lib/content';
import Button from '@components/ui/Button.astro';
import MediaSlot from '@components/ui/MediaSlot.astro';

const settings = await getGlobalSettings();
---

{settings.financingVerified && (
  <section id="financing" class="section section--off-white financing" data-nav-theme="light">
    <div class="container financing__layout">
      <div>
        <p class="eyebrow" data-reveal="up">Financing</p>
        <h2 class="h2 financing__heading" data-reveal="up">Financing <span class="accent-text">Available.</span></h2>
        {settings.financingOffer.verified && settings.financingOffer.headline && (
          <p class="financing__offer" data-reveal="up">{settings.financingOffer.headline}</p>
        )}
        <p class="text-muted financing__body" data-reveal="up">
          A roofing project is a major investment. Qualified homeowners may
          have access to financing options that allow them to move forward
          without paying the full project cost upfront.
        </p>
        <div class="financing__actions" data-reveal="up">
          <Button href="/contact/" analyticsEvent="financing_click" analyticsLocation="homepage_financing">
            Ask About Financing
          </Button>
          <Button href={settings.primaryCtaDestination} variant="outline">
            Get a Free Estimate
          </Button>
        </div>
        <a href="/about/#roofing-advice" class="financing__video-link" data-reveal="up">
          Watch: Understanding Roof Financing <span aria-hidden="true">→</span>
        </a>
        {settings.financingOffer.verified && settings.financingOffer.disclosure && (
          <p class="financing__disclosure" data-reveal="up">{settings.financingOffer.disclosure}</p>
        )}
      </div>
      <div class="financing__art" data-reveal="image">
        <MediaSlot tone="light" variant={3} label="Financing for roofing projects" />
      </div>
    </div>
  </section>
)}

<style>
  .financing__layout {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .financing__heading { margin-top: var(--space-2); }
  .financing__offer {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }
  .financing__body { margin-block: var(--space-3) var(--space-6); max-width: 46ch; }
  .financing__disclosure {
    margin-top: var(--space-4);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 52ch;
  }
  .financing__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .financing__video-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent-dark);
  }
  .financing__video-link:hover { text-decoration: underline; }
  .financing__art {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .financing__layout { grid-template-columns: 1fr 1fr; }
  }
</style>
