---
const slugs = ['roof-replacement', 'roof-inspection', 'roof-cleaning', 'roof-repair', 'roof-rejuvenation'];
import { getCollection, getEntry } from 'astro:content';
import MediaSlot from '@components/ui/MediaSlot.astro';

const allServices = await getCollection('services', ({ data }) => data.published);
const services = slugs
  .map((slug) => allServices.find((s) => s.id === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

// Real project photography per service, where it's an honest match.
// Rejuvenation intentionally gets no project photo — no project shown here
// is a rejuvenation job, so it keeps the neutral branded fallback instead
// of implying otherwise.
const project01 = await getEntry('projects', 'project-01-shingle-roof-replacement');
const project03 = await getEntry('projects', 'project-03-water-damage-roof-repair');
const project04 = await getEntry('projects', 'project-04-small-shingle-replacement');

const serviceImages: Record<string, { image?: string; alt: string }> = {
  'roof-replacement': { image: project01?.data.afterImages[0], alt: 'Completed shingle roof viewed from the front of the house' },
  'roof-inspection': { image: project03?.data.duringImages[0], alt: "Close-up of a roof drainage detail that was improperly positioned" },
  'roof-cleaning': { image: project04?.data.beforeImages[0], alt: 'Roof with visible moss growth before cleaning' },
  'roof-repair': { image: project03?.data.duringImages[1], alt: 'Water-damaged roof decking discovered during a repair inspection' },
};
---

<section class="section section--charcoal services-grid" data-nav-theme="dark" data-nav-section="services">
  <div class="container">
    <p class="eyebrow eyebrow--center" data-reveal="up">What We Do</p>
    <h2 class="h2 services-grid__heading" data-reveal="up">Roofing Services Built For The <span class="accent-text">Pacific Northwest</span></h2>
    <p class="text-muted services-grid__lede" data-reveal="up">Roof replacement, repair, inspection, cleaning, and rejuvenation, handled by one local team.</p>

    <div class="services-grid__cards" data-reveal-group>
      {services.map((service, i) => {
        const featured = service.id === 'roof-replacement';
        const image = serviceImages[service.id];
        return (
          <a
            href={`/services/${service.id}/`}
            class:list={['service-card', featured && 'service-card--featured']}
            data-reveal="up"
            data-analytics-event="service_clicked"
            data-analytics-location={`services_grid_${service.id}`}
          >
            <div class="service-card__media">
              {image ? (
                <MediaSlot image={image.image} alt={image.alt} tone="dark" variant={2} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 46vw, 92vw" />
              ) : (
                <MediaSlot tone="dark" variant={2} label={`${service.data.title}, photography pending`} />
              )}
              {featured && <span class="service-card__badge">Our #1 Service</span>}
            </div>
            <div class="service-card__body">
              <span class="service-card__number">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="service-card__title">{service.data.title}</h3>
              <p class="text-muted service-card__desc">{service.data.shortDescription}</p>
              <span class="service-card__link">Learn More <span class="hover-arrow" aria-hidden="true">→</span></span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services-grid__heading { text-align: center; margin-top: var(--space-2); }
  .services-grid__lede { text-align: center; max-width: 56ch; margin: var(--space-3) auto 0; }

  /* A 6-column grid lets a full-width card span 2 columns, so the 2 leftover
     cards on row 2 (repair, rejuvenation) can sit centered under 3 columns
     by spanning the middle 4 of 6 tracks, instead of hugging the left edge. */
  .services-grid__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--color-charcoal-raised);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }
  .service-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .service-card--featured { border: 1.5px solid var(--color-accent); }

  .service-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 0;
    min-width: 0;
  }
  .service-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 500ms var(--ease-out); }
  .service-card:hover .service-card__media :global(img) { transform: scale(1.035); }
  .service-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-black);
    background: var(--color-accent);
    padding: 0.35em 0.7em;
    border-radius: var(--radius-sm);
  }

  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1;
  }
  .service-card__number {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--color-accent);
    opacity: 0.6;
    line-height: 1;
  }
  .service-card__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }
  .service-card__desc { max-width: 42ch; }
  .service-card__link {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .services-grid__cards { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .services-grid__cards { grid-template-columns: repeat(6, 1fr); }
    /* row 1: replacement, inspection, cleaning — each spans 2 of 6 columns */
    .service-card:nth-child(1) { grid-column: 1 / 3; }
    .service-card:nth-child(2) { grid-column: 3 / 5; }
    .service-card:nth-child(3) { grid-column: 5 / 7; }
    /* row 2: repair, rejuvenation — centered under the 6-column track */
    .service-card:nth-child(4) { grid-column: 2 / 4; }
    .service-card:nth-child(5) { grid-column: 4 / 6; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card__media :global(img) { transition: none; }
  }
</style>
