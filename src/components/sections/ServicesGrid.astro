---
const slugs = ['roof-replacement', 'roof-inspection', 'roof-cleaning', 'roof-repair', 'roof-rejuvenation'];
import { getCollection, getEntry } from 'astro:content';
import MediaSlot from '@components/ui/MediaSlot.astro';

const allServices = await getCollection('services', ({ data }) => data.published);
const services = slugs
  .map((slug) => allServices.find((s) => s.id === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const featured = services.find((s) => s.id === 'roof-replacement');
const supporting = services.filter((s) => s.id !== 'roof-replacement');

// Real project photography per service, where it's an honest match.
// Rejuvenation intentionally gets no project photo — no project shown here
// is a rejuvenation job, so it keeps the neutral branded fallback instead
// of implying otherwise.
const project01 = await getEntry('projects', 'project-01-shingle-roof-replacement');
const project03 = await getEntry('projects', 'project-03-water-damage-roof-repair');
const project04 = await getEntry('projects', 'project-04-small-shingle-replacement');

const serviceImages: Record<string, { image?: string; alt: string }> = {
  'roof-replacement': { image: project01?.data.afterImages[0], alt: 'Completed shingle roof viewed from the front of the house' },
  'roof-inspection': { image: project03?.data.duringImages[0], alt: "Close-up of a roof drainage detail that was improperly positioned" },
  'roof-cleaning': { image: project04?.data.beforeImages[0], alt: 'Roof with visible moss growth before cleaning' },
  'roof-repair': { image: project03?.data.afterImages[0], alt: 'New shingles installed after a roof repair' },
};
---

<section class="section section--charcoal services-grid" data-nav-theme="dark" data-nav-section="services">
  <div class="container">
    <p class="eyebrow eyebrow--center" data-reveal="up">What We Do</p>
    <h2 class="h2 services-grid__heading" data-reveal="up">Roofing Services Built For The <span class="accent-text">Pacific Northwest</span></h2>
    <p class="text-muted services-grid__lede" data-reveal="up">Roof replacement, repair, inspection, cleaning, and rejuvenation, handled by one local team.</p>

    {featured && (
      <a href={`/services/${featured.id}/`} class="service-featured-row" data-reveal="up" data-analytics-event="service_clicked" data-analytics-location="services_grid_featured">
        <div class="service-featured-row__media">
          <MediaSlot image={serviceImages['roof-replacement'].image} alt={serviceImages['roof-replacement'].alt} tone="dark" variant={1} sizes="(min-width: 720px) 320px, 100vw" />
        </div>
        <div class="service-featured-row__body">
          <span class="service-featured-row__badge">Our #1 Service</span>
          <span class="service-featured-row__number">01</span>
          <span class="service-featured-row__title">{featured.data.title}</span>
          <span class="text-muted service-featured-row__desc">{featured.data.shortDescription}</span>
          <span class="service-featured-row__link">Learn More <span class="hover-arrow" aria-hidden="true">→</span></span>
        </div>
      </a>
    )}

    <div class="services-grid__supporting" data-reveal-group>
      {supporting.map((service, i) => (
        <a href={`/services/${service.id}/`} class="service-card" data-reveal="up" data-analytics-event="service_clicked" data-analytics-location={`services_grid_${service.id}`}>
          {serviceImages[service.id] ? (
            <div class="service-card__media">
              <MediaSlot image={serviceImages[service.id].image} alt={serviceImages[service.id].alt} tone="dark" variant={2} sizes="(min-width: 720px) 30vw, 90vw" />
            </div>
          ) : (
            <div class="service-card__media">
              <MediaSlot tone="dark" variant={2} label={`${service.data.title}, photography pending`} />
            </div>
          )}
          <div class="service-card__body">
            <span class="service-card__number">{String(i + 2).padStart(2, '0')}</span>
            <h3 class="service-card__title">{service.data.title}</h3>
            <p class="text-muted service-card__desc">{service.data.shortDescription}</p>
            <span class="service-card__link">Learn More <span class="hover-arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid__heading { text-align: center; margin-top: var(--space-2); }
  .services-grid__lede { text-align: center; max-width: 56ch; margin: var(--space-3) auto 0; }

  .service-featured-row {
    display: grid;
    gap: 0;
    margin-top: var(--space-6);
    background: linear-gradient(120deg, var(--color-charcoal-raised) 0%, var(--color-charcoal) 100%);
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .service-featured-row:hover { transform: translateY(-2px); }
  .service-featured-row__media { aspect-ratio: 16 / 10; }
  .service-featured-row__media :global(img) { transition: transform 500ms var(--ease-out); }
  .service-featured-row:hover .service-featured-row__media :global(img) { transform: scale(1.03); }
  .service-featured-row__body {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-5) var(--space-6);
    min-width: 0;
  }
  .service-featured-row__desc { min-width: 0; }
  .service-featured-row__badge {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-black);
    background: var(--color-accent);
    padding: 0.3em 0.7em;
    border-radius: var(--radius-sm);
  }
  .service-featured-row__number {
    font-family: var(--font-display);
    font-size: var(--step-4);
    color: var(--color-accent);
    opacity: 0.6;
    line-height: 1;
  }
  .service-featured-row__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }
  .service-featured-row__desc { grid-column: 2 / 3; max-width: 46ch; }
  .service-featured-row__link {
    grid-row: 1 / 3;
    grid-column: 3 / 4;
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .services-grid__supporting { display: grid; gap: var(--space-4); margin-top: var(--space-4); }

  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--color-charcoal-raised);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }
  .service-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .service-card__media { aspect-ratio: 16 / 10; }
  .service-card__media :global(img) { transition: transform 500ms var(--ease-out); }
  .service-card:hover .service-card__media :global(img) { transform: scale(1.035); }
  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1;
  }
  .service-card__number {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--color-accent);
    opacity: 0.6;
    line-height: 1;
  }
  .service-card__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }
  .service-card__desc { max-width: 42ch; }
  .service-card__link {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  @media (min-width: 720px) {
    .services-grid__supporting { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 640px) {
    .service-featured-row { grid-template-columns: 320px 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-featured-row__media :global(img),
    .service-card__media :global(img) { transition: none; }
  }
</style>
