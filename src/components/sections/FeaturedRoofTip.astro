---
/**
 * The homepage's single featured roof-tip video (never all three, see the
 * About video library for those) — a real recorded clip, not stock/AI
 * content, meant to make the site feel like an actual local roofer rather
 * than a template.
 */
import { getEntry } from 'astro:content';
import RoofTipVideo from '@components/media/RoofTipVideo.astro';
import Button from '@components/ui/Button.astro';

const video = await getEntry('videos', 'beat-the-rain');
---

{video?.data.published && (
  <section class="section section--dark-charcoal featured-tip" data-nav-theme="dark">
    <div class="container split">
      <div data-reveal="image">
        <RoofTipVideo
          src={video.data.videoUrl}
          poster={video.data.poster}
          title={video.data.title}
          topic={video.data.topic}
          preload="none"
          showDetails={false}
        />
      </div>
      <div>
        <p class="eyebrow eyebrow--inverse" data-reveal="up">Roofing Advice From JBA</p>
        <h2 class="h2" data-reveal="up">Don't Wait For The First Big Rain.</h2>
        <p class="text-muted featured-tip__body" data-reveal="up">{video.data.shortDescription}</p>
        <div class="featured-tip__actions" data-reveal="up">
          {video.data.ctaLabel && video.data.ctaHref && (
            <Button href={video.data.ctaHref} analyticsEvent="estimate_cta_click" analyticsLocation="featured_roof_tip">
              {video.data.ctaLabel}
            </Button>
          )}
          <a href="/about/#roofing-advice" class="featured-tip__more">More Roofing Tips <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .featured-tip__body { margin-top: var(--space-3); max-width: 52ch; }
  .featured-tip__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin-top: var(--space-5); }
  .featured-tip__more { font-weight: 700; color: var(--color-accent); }
  .featured-tip__more:hover { text-decoration: underline; }
</style>
