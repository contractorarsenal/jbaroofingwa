---
import { getEntry } from 'astro:content';
import ReviewCard from '@components/reviews/ReviewCard.astro';
import Button from '@components/ui/Button.astro';
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();

// A specific, deliberately chosen set (GAF product mention + cleanup/decking
// proof + communication proof + property-care proof) rather than "whichever
// reviews happen to sort first" — see the homeowner-proof pass for why.
const featuredIds = ['ajeet-singh', 'prakash-karuppusamy', 'nhat-le'];
const reviews = (
  await Promise.all(featuredIds.map((id) => getEntry('reviews', id)))
).filter((r): r is NonNullable<typeof r> => Boolean(r?.data.published));
---

<section class="section section--black proof" data-nav-theme="dark">
  <div class="container">
    <div class="proof__header" data-reveal="up">
      <p class="eyebrow eyebrow--inverse eyebrow--center">Real Customer Feedback</p>
      <h2 class="h2 proof__heading">Homeowners Trust <span class="accent-text">JBA.</span></h2>
      <p class="text-muted proof__count">100+ Google Reviews</p>
    </div>

    {reviews.length > 0 ? (
      <>
        <div class="grid grid--3" data-reveal-group>
          {reviews.map((review) => <ReviewCard review={review} data-reveal="up" />)}
        </div>
        {settings.googleBusinessProfileUrl && (
          <div class="proof__footer" data-reveal="up">
            <Button href={settings.googleBusinessProfileUrl} variant="outline" data-analytics-event="outbound_click" data-analytics-destination="google_reviews">Read More Reviews</Button>
          </div>
        )}
      </>
    ) : (
      <div class="proof__empty" data-reveal="up">
        <h3 class="proof__empty-title">100+ Google Reviews</h3>
        <p class="text-muted">
          Individual reviews are being added to this page. In the meantime,
          verified reviews are visible directly on our Google Business Profile.
        </p>
        {settings.googleBusinessProfileUrl && (
          <div class="proof__footer">
            <Button href={settings.googleBusinessProfileUrl} variant="outline" data-analytics-event="outbound_click" data-analytics-destination="google_reviews">View Our Google Reviews</Button>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .proof__header { text-align: center; max-width: 640px; margin: 0 auto var(--space-6); }
  .proof__count { margin-top: var(--space-2); font-weight: 700; letter-spacing: 0.02em; }
  .proof__footer { text-align: center; margin-top: var(--space-6); }
  .proof__empty {
    text-align: center;
    padding: var(--space-8) var(--space-6);
    background: var(--color-charcoal);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    max-width: 60ch;
    margin-inline: auto;
  }
  .proof__empty-title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    text-transform: uppercase;
    color: var(--color-text-inverse);
    margin-bottom: var(--space-3);
  }
</style>
