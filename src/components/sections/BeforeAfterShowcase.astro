---
import { getPublishedProjects } from '@lib/content';
import BeforeAfterSlider from '@components/projects/BeforeAfterSlider.astro';
import { projectImageAlt } from '@lib/project-media';

const projects = await getPublishedProjects();
const withPhotos = projects.filter((p) => p.data.beforeImages[0] && p.data.afterImages[0]);

// Priority order per the client's explicit preference — Project 01 first
// (strongest single pairing), then 04, then 06 — rather than whatever order
// the collection happens to sort in.
const priority = [
  'project-01-shingle-roof-replacement',
  'project-04-small-shingle-replacement',
  'project-06-aging-roof-replacement',
];
const ordered = [
  ...priority.map((id) => withPhotos.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => Boolean(p)),
  ...withPhotos.filter((p) => !priority.includes(p.id)),
];
---

<section class="section section--charcoal before-after" data-nav-theme="dark">
  <div class="container">
    <p class="eyebrow eyebrow--inverse eyebrow--center" data-reveal="up">The JBA Difference</p>
    <h2 class="h2 before-after__heading" data-reveal="up">See The <span class="accent-text">Difference.</span></h2>

    {ordered.length > 0 && (
      <div class="grid grid--3 before-after__grid" data-reveal-group>
        {ordered.slice(0, 3).map((project) => (
          <div data-reveal="up">
            <BeforeAfterSlider
              beforeImage={project.data.beforeImages[0]}
              afterImage={project.data.afterImages[0]}
              beforeAlt={projectImageAlt(project.data.beforeImages[0], 'Before')}
              afterAlt={projectImageAlt(project.data.afterImages[0], 'After')}
            />
            <p class="before-after__caption">{project.data.city ? `${project.data.city} · ` : ''}{project.data.projectName}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .before-after__heading { text-align: center; margin-top: var(--space-2); }
  .before-after__grid { margin-top: var(--space-6); }
  .before-after__caption { margin-top: var(--space-3); font-weight: 700; text-align: center; }
</style>
