---
import { getGlobalSettings } from '@lib/content';
import Button from '@components/ui/Button.astro';

const settings = await getGlobalSettings();
const currentPath = Astro.url.pathname;

// Fixed, intentional list — not every published service belongs in primary
// nav (siding services are deliberately excluded here; roofing stays the
// dominant story in navigation).
const roofServices = [
  { slug: 'roof-replacement', label: 'Roof Replacement', description: 'Complete roofing systems for aging or damaged roofs.' },
  { slug: 'roof-inspection', label: 'Roof Inspection', description: "Understand your roof's condition before making a decision." },
  { slug: 'roof-cleaning', label: 'Roof Cleaning', description: 'Remove buildup and maintain the roof safely.' },
  { slug: 'roof-repair', label: 'Roof Repair', description: 'Leaks, flashing, storm damage, and localized issues.' },
  { slug: 'roof-rejuvenation', label: 'Roof Rejuvenation', description: 'Extend usable roof life when replacement is not yet necessary.' },
];
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label={`${settings.businessName} home`}>
      <img src="/images/brand/jba-nav-logo.webp" alt="" width="240" height="240" />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <a href="/about/" class="nav-link" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>About Us</a>
      <a href="/projects/" class="nav-link" data-nav-key="work" aria-current={currentPath.startsWith('/projects') ? 'page' : undefined}>Our Work</a>
      <div class="nav-item nav-item--dropdown">
        <button class="nav-link" data-nav-key="services" aria-expanded="false" data-dropdown-trigger>
          Roof Services
          <svg width="10" height="10" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 5L7 11L13 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-dropdown" data-dropdown>
          {roofServices.map((service) => (
            <a href={`/services/${service.slug}/`} class="nav-dropdown__link">
              <span class="nav-dropdown__link-title">{service.label}</span>
              <span class="nav-dropdown__link-desc">{service.description}</span>
            </a>
          ))}
        </div>
      </div>
      <a href="/service-areas/" class="nav-link" data-nav-key="areas" aria-current={currentPath.startsWith('/service-areas') ? 'page' : undefined}>Service Areas</a>
      <a href="/contact/" class="nav-link" aria-current={currentPath.startsWith('/contact') ? 'page' : undefined}>Contact</a>
    </nav>

    <div class="site-header__actions">
      <a href={`tel:${settings.primaryPhone}`} class="site-header__phone" data-analytics-event="phone_click" data-analytics-location="header">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Call Now
      </a>
      <Button href={settings.primaryCtaDestination} analyticsEvent="quote_started">
        {settings.primaryCtaLabel}
      </Button>
    </div>

    <div class="site-header__mobile-actions">
      <a href={`tel:${settings.primaryPhone}`} class="site-header__mobile-call" data-analytics-event="phone_click" data-analytics-location="mobile_header" aria-label="Call now">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button class="site-header__burger" data-menu-trigger aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile primary">
      <a href="/about/">About Us</a>
      <a href="/projects/">Our Work</a>
      <details class="mobile-menu__services">
        <summary>Roof Services</summary>
        <div class="mobile-menu__services-collapse">
          <div class="mobile-menu__services-list">
            {roofServices.map((service) => (
              <a href={`/services/${service.slug}/`}>{service.label}</a>
            ))}
          </div>
        </div>
      </details>
      <a href="/service-areas/">Service Areas</a>
      <a href="/contact/">Contact</a>
    </nav>
    <div class="mobile-menu__actions">
      <a href={`tel:${settings.primaryPhone}`} class="btn btn--outline btn--block" data-analytics-event="phone_click" data-analytics-location="mobile_menu">
        Call Now
      </a>
      <Button href={settings.primaryCtaDestination} block analyticsEvent="quote_started">
        {settings.primaryCtaLabel}
      </Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(8, 8, 8, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: background-color 320ms var(--ease-out), border-color 320ms var(--ease-out),
                box-shadow 320ms var(--ease-out);
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--color-border-dark);
    box-shadow: var(--shadow-sm);
  }
  .site-header[data-theme="light"] {
    background: rgba(255, 255, 255, 0.96);
  }
  .site-header[data-theme="light"][data-scrolled] {
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }
  .site-header[data-theme="light"] .site-header__phone,
  .site-header[data-theme="light"] .site-header__mobile-call {
    color: var(--color-text);
  }
  .site-header[data-theme="light"] .site-header__mobile-call { border-color: var(--color-border); }
  .site-header[data-theme="light"] .site-header__burger span { background: var(--color-text); }
  .site-header[data-theme="light"] .nav-link { color: var(--color-text-muted); }
  .site-header[data-theme="light"] .nav-link:hover,
  .site-header[data-theme="light"] .nav-link.is-active,
  .site-header[data-theme="light"] .nav-link[aria-current="page"] { color: var(--color-accent-dark); }
  .site-header[data-theme="light"] .nav-link::after { background: var(--color-accent-dark); }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 70px;
  }
  @media (min-width: 1080px) {
    .site-header__inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
    }
    .site-header__logo { grid-column: 1; }
    .site-header__nav { grid-column: 2; justify-content: center; }
    .site-header__actions { grid-column: 3; justify-self: end; }
  }
  .site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: opacity 200ms var(--ease-out);
  }
  .site-header__logo:hover { opacity: 0.9; }
  .site-header__logo img {
    display: block;
    width: auto;
    height: auto;
    max-height: 44px;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__logo { transition: none; }
  }
  .site-header__nav {
    display: none;
    align-items: center;
    gap: var(--space-4);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: none;
    border: none;
    padding: var(--space-1) 0;
    color: var(--color-text-inverse-muted);
    transition: color 260ms var(--ease-out);
    white-space: nowrap;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -4px;
    height: 2px;
    background: var(--color-accent);
    transition: right 200ms var(--ease-out);
  }
  .nav-link:hover { color: var(--color-text-inverse); }
  .nav-link:hover::after,
  .nav-link.is-active::after { right: 0; }
  .nav-link[aria-current="page"] { color: var(--color-accent); }
  .nav-item--dropdown { position: relative; }
  .nav-dropdown {
    display: flex;
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: var(--space-3);
    background: var(--color-charcoal);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: var(--space-2);
    width: 340px;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -6px) scale(0.985);
    transform-origin: top center;
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out), visibility 0s linear 200ms;
  }
  .nav-dropdown::before {
    /* Invisible hover bridge filling the gap between the trigger and the
       dropdown panel — without this, moving the pointer straight down from
       "Roof Services" into the gap leaves both the trigger and the panel
       un-hovered for a moment, closing the menu before the user arrives. */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-1 * var(--space-3));
    height: var(--space-3);
  }
  .nav-item--dropdown:hover .nav-dropdown,
  .nav-item--dropdown:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
    transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out), visibility 0s linear 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown { transition: opacity 1ms linear, visibility 1ms linear; }
  }
  .nav-dropdown__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
  }
  .nav-dropdown__link:hover { background: var(--color-charcoal-raised); }
  .nav-dropdown__link-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-inverse);
  }
  .nav-dropdown__link:hover .nav-dropdown__link-title { color: var(--color-accent); }
  .nav-dropdown__link-desc {
    font-size: 0.75rem;
    color: var(--color-text-inverse-muted);
    line-height: 1.4;
  }

  .site-header__actions {
    display: none;
    align-items: center;
    gap: var(--space-4);
  }
  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-text-inverse);
    white-space: nowrap;
  }
  .site-header__phone svg { color: var(--color-accent); }
  .site-header__actions .btn { height: 44px; padding-inline: 1.25rem; }

  .site-header__mobile-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .site-header__mobile-call {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    transition: border-color 320ms var(--ease-out);
  }
  .site-header__burger {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    padding: var(--space-2);
    margin: calc(var(--space-2) * -1);
  }
  .site-header__burger span {
    width: 20px;
    height: 2px;
    background: var(--color-text-inverse);
    transition: transform var(--duration-base) var(--ease-out), opacity var(--duration-base) var(--ease-out),
                background-color 320ms var(--ease-out);
  }
  .site-header__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .site-header__burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .site-header__burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mobile-menu {
    border-top: 1px solid var(--color-border-dark);
    padding: var(--space-4) var(--container-pad) var(--space-6);
    background: var(--color-black);
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu nav > a {
    padding: var(--space-3) 0;
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--color-text-inverse);
    border-bottom: 1px solid var(--color-border-dark);
  }
  .mobile-menu__services {
    border-bottom: 1px solid var(--color-border-dark);
  }
  .mobile-menu__services summary {
    padding: var(--space-3) 0;
    font-weight: 600;
    font-size: var(--step-0);
    color: var(--color-text-inverse);
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu__services summary::-webkit-details-marker { display: none; }
  .mobile-menu__services-collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 260ms var(--ease-out);
  }
  .mobile-menu__services[open] .mobile-menu__services-collapse {
    grid-template-rows: 1fr;
  }
  .mobile-menu__services-list {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
    padding-bottom: var(--space-3);
  }
  .mobile-menu__services-list a {
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
    font-size: 0.9rem;
    color: var(--color-text-inverse-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__services-collapse { transition: none; }
  }
  .mobile-menu__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  @media (min-width: 1080px) {
    .site-header__nav, .site-header__actions { display: flex; }
    .site-header__mobile-actions { display: none; }
    .mobile-menu { display: none; }
  }

  @media (max-width: 1079px) {
    .site-header__logo img { max-height: 36px; }
  }

  /* mobile menu content stagger — plays whenever the panel becomes visible,
     regardless of the hidden-attribute toggle in the script below */
  @keyframes mobileLinkRise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .mobile-menu:not([hidden]) nav > a,
  .mobile-menu:not([hidden]) nav > .mobile-menu__services {
    animation: mobileLinkRise 320ms var(--ease-out) both;
  }
  .mobile-menu:not([hidden]) nav > a:nth-child(1) { animation-delay: 40ms; }
  .mobile-menu:not([hidden]) nav > a:nth-child(2) { animation-delay: 80ms; }
  .mobile-menu:not([hidden]) nav > .mobile-menu__services:nth-child(3) { animation-delay: 120ms; }
  .mobile-menu:not([hidden]) nav > a:nth-child(4) { animation-delay: 160ms; }
  .mobile-menu:not([hidden]) nav > a:nth-child(5) { animation-delay: 200ms; }
</style>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');

  const stickyCta = document.querySelector<HTMLElement>('[data-sticky-cta]');

  trigger?.addEventListener('click', () => {
    const expanded = trigger.getAttribute('aria-expanded') === 'true';
    trigger.setAttribute('aria-expanded', String(!expanded));
    if (menu) menu.hidden = expanded;
    if (stickyCta) stickyCta.hidden = !expanded;
  });

  const updateScrolled = () => {
    if (!header) return;
    if (window.scrollY > 40) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');
  };
  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });
</script>
