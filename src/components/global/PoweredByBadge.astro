<!--
  Floating "Made by Contractor Arsenal" badge.

  Visibility rules (kept deliberately simple so the badge never flickers):
  - Sits above the mobile call/estimate bar (body.has-sticky-cta).
  - Hidden while the cookie notice is showing (CSS sibling rule, no JS).
  - Hidden only when its own box genuinely overlaps a protected element:
    form fields and buttons, call/estimate links and buttons, the footer
    text, or the sticky bar. Unrelated content entering the viewport never
    hides it.
  - Hysteresis: once hidden, it returns only after 600ms with no overlap,
    so it cannot oscillate during fast or slow scrolling.
  - Hidden state uses visibility:hidden and pointer-events:none, so it never
    blocks clicks or takes focus while invisible.
-->
<a
  class="powered-badge"
  href="https://contractorarsenal.com"
  target="_blank"
  rel="noopener noreferrer"
  data-powered-badge
>
  <svg class="powered-badge__icon" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M3 13.5 12 5l9 8.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M7 19.5V12.5M17 19.5V12.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
  </svg>
  <span>Made by Contractor Arsenal</span>
  <span class="sr-only">(opens in a new tab)</span>
</a>

<style>
  .powered-badge {
    --powered-red: #c92332;
    --powered-red-hover: #a81c29;

    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: var(--z-sticky-cta);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    background: var(--powered-red);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 6px 18px rgba(120, 12, 22, 0.32);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 180ms var(--ease-out), opacity 180ms var(--ease-out), visibility 0s linear 0s;
  }
  .powered-badge:hover {
    background: var(--powered-red-hover);
  }
  .powered-badge:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
    box-shadow: 0 0 0 5px rgba(201, 35, 50, 0.55);
  }
  .powered-badge__icon {
    flex-shrink: 0;
  }

  /* Hidden while the cookie notice is showing (it is a sibling rendered before this badge). */
  :global(.cookie-notice:not([hidden])) ~ .powered-badge {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Hidden only while a protected element overlaps it (see script). */
  .powered-badge--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 180ms var(--ease-out), visibility 0s linear 180ms;
  }

  /* Mobile: slightly smaller, and lifted above the sticky call/estimate bar. */
  @media (max-width: 1079px) {
    :global(body.has-sticky-cta) .powered-badge {
      bottom: calc(56px + env(safe-area-inset-bottom, 0px) + var(--space-3));
      right: var(--space-3);
      padding: 0.45rem 0.75rem;
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .powered-badge,
    .powered-badge--hidden { transition: none; }
  }
</style>

<script>
  const badge = document.querySelector<HTMLElement>('[data-powered-badge]');

  // Elements the badge must never sit on top of.
  const PROTECTED =
    'form input, form textarea, form select, form button, form a, ' +
    'a[href^="tel:"], a[href="/assessment/"], a.btn, button.btn, ' +
    '.site-footer__copyright, .site-footer__legal a, .sticky-cta a';
  const HOLD_MS = 600; // clear time required before a hidden badge returns

  if (badge) {
    let targets: HTMLElement[] = [];
    let hidden = false;
    let lastOverlapAt = 0;
    let frame = 0;
    let retry: number | undefined;

    // Find targets once per layout change, not on every scroll frame.
    const refreshTargets = () => {
      targets = Array.from(document.querySelectorAll<HTMLElement>(PROTECTED)).filter(
        (el) => !el.closest('.cookie-notice, [data-powered-badge]')
      );
    };

    const overlapsProtected = (): boolean => {
      const b = badge.getBoundingClientRect();
      if (!b.width || !b.height) return false;
      for (const el of targets) {
        const r = el.getBoundingClientRect();
        if (!r.width || !r.height) continue;
        if (r.left < b.right && r.right > b.left && r.top < b.bottom && r.bottom > b.top) return true;
      }
      return false;
    };

    const setHidden = (value: boolean) => {
      if (value === hidden) return;
      hidden = value;
      badge.classList.toggle('powered-badge--hidden', value);
    };

    const update = () => {
      frame = 0;
      const now = performance.now();
      if (overlapsProtected()) {
        lastOverlapAt = now;
        setHidden(true);
        return;
      }
      if (!hidden) return;
      const remaining = HOLD_MS - (now - lastOverlapAt);
      if (remaining <= 0) {
        setHidden(false);
      } else {
        // Re-check once the hold has elapsed, even if the page stops scrolling.
        window.clearTimeout(retry);
        retry = window.setTimeout(schedule, remaining + 16);
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    refreshTargets();
    schedule();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', () => {
      refreshTargets();
      schedule();
    }, { passive: true });
  }
</script>
