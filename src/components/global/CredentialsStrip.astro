---
/**
 * Compact credential row placed right after the Hero: the specific
 * manufacturer/license/review proof points (GAF Master Elite, WA license,
 * Google review count). This is deliberately separate from TrustFacts
 * (8+ Years / Free Estimates / Financing / 24-Hour Service) below it —
 * that row is general trust facts, this one is verifiable credentials.
 * Only verified items render; nothing here is guessed.
 */
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();

const additional = (settings.additionalCredentials ?? [])
  .filter((c) => c.verified && c.published)
  .sort((a, b) => a.displayOrder - b.displayOrder);
---

<div class="credentials-strip" data-nav-theme="dark">
  <div class="container">
    <ul class="credentials-strip__row" data-reveal="up">
      {settings.credential.verified && (
        <li class="credentials-strip__item">
          {settings.credential.badgeImage && (
            <img
              class="credentials-strip__badge"
              src={settings.credential.badgeImage}
              alt=""
              width="36"
              height="36"
              loading="lazy"
            />
          )}
          <span>
            {settings.credential.name}
            {settings.credential.contractorId && (
              <span class="credentials-strip__sub">Contractor ID {settings.credential.contractorId}</span>
            )}
          </span>
        </li>
      )}

      {settings.contractorLicense.verified && settings.contractorLicense.value && (
        <li class="credentials-strip__item">
          <span>
            WA License
            <span class="credentials-strip__sub">{settings.contractorLicense.value}</span>
          </span>
        </li>
      )}

      {(settings.googleReviewCount ?? 0) > 0 && (
        <li class="credentials-strip__item">
          <svg class="credentials-strip__google" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path fill="#4285F4" d="M23.52 12.27c0-.85-.08-1.67-.22-2.45H12v4.64h6.47c-.28 1.5-1.13 2.78-2.4 3.63v3h3.88c2.27-2.09 3.57-5.17 3.57-8.82z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.95-2.91l-3.88-3c-1.08.72-2.45 1.15-4.07 1.15-3.13 0-5.78-2.11-6.73-4.96H1.26v3.11C3.24 21.3 7.29 24 12 24z"/>
            <path fill="#FBBC05" d="M5.27 14.28A7.2 7.2 0 0 1 4.9 12c0-.79.14-1.56.37-2.28V6.61H1.26A11.97 11.97 0 0 0 0 12c0 1.94.46 3.77 1.26 5.39l4.01-3.11z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.44-3.44C17.95 1.19 15.24 0 12 0 7.29 0 3.24 2.7 1.26 6.61l4.01 3.11C6.22 6.86 8.87 4.75 12 4.75z"/>
          </svg>
          <span>100+ Google Reviews</span>
        </li>
      )}

      {additional.map((c) => (
        c.verificationUrl ? (
          <li class="credentials-strip__item">
            <a href={c.verificationUrl} target="_blank" rel="noopener noreferrer" class="credentials-strip__link">
              {c.image && <img class="credentials-strip__badge" src={c.image} alt="" width="36" height="36" loading="lazy" />}
              <span>{c.shortLabel ?? c.name}</span>
            </a>
          </li>
        ) : (
          <li class="credentials-strip__item">
            {c.image && <img class="credentials-strip__badge" src={c.image} alt="" width="36" height="36" loading="lazy" />}
            <span>{c.shortLabel ?? c.name}</span>
          </li>
        )
      ))}
    </ul>
  </div>
</div>

<style>
  .credentials-strip {
    position: relative;
    z-index: 1;
    background: var(--color-black);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border-dark);
  }

  .credentials-strip__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-5) var(--space-6);
  }

  .credentials-strip__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-text-inverse);
    white-space: nowrap;
  }

  .credentials-strip__badge {
    display: block;
    border-radius: 50%;
    object-fit: contain;
    flex-shrink: 0;
  }

  .credentials-strip__google { flex-shrink: 0; }

  .credentials-strip__sub {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--color-text-inverse-muted);
  }

  .credentials-strip__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
  }
  .credentials-strip__link:hover { color: var(--color-accent); }

  @media (max-width: 640px) {
    .credentials-strip__row {
      justify-content: flex-start;
      overflow-x: auto;
      flex-wrap: nowrap;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 2px;
    }
    .credentials-strip__item { white-space: nowrap; }
  }
</style>
