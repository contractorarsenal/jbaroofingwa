---
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();

const items: string[] = [];
if (settings.googleRating && settings.googleReviewCount) {
  items.push(`★ ${settings.googleRating.toFixed(1)} Google Rating`);
}
if (settings.yearsExperience.verified && settings.yearsExperience.value) {
  items.push(settings.yearsExperience.value);
}
if (settings.emergencyAvailability.verified && settings.emergencyAvailability.value) {
  items.push(settings.emergencyAvailability.value);
}
items.push('Free Estimates');
if (settings.financingVerified) {
  items.push('Financing Available');
}
items.push(
  [settings.primaryServiceArea, ...settings.secondaryServiceAreas]
    .map((a) => a.replace(' County, WA', ''))
    .join(' • ')
);
---

<div class="trust-strip" data-nav-theme="light">
  <div class="container trust-strip__inner" data-reveal-group>
    {items.map((item) => (
      <span class="trust-strip__item" data-reveal="up">{item}</span>
    ))}
  </div>
</div>

<style>
  .trust-strip {
    position: relative;
    z-index: 1;
    background: var(--color-bg);
    padding-block: var(--space-3);
    border-block: 1px solid var(--color-border);
  }
  .trust-strip__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
  }
  @media (min-width: 900px) {
    .trust-strip { margin-top: -22px; }
  }
  .trust-strip__item {
    position: relative;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-text);
    padding-left: var(--space-4);
  }
  .trust-strip__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-accent);
  }
  .trust-strip__item:first-child { padding-left: 0; }
  .trust-strip__item:first-child::before { display: none; }

  @media (min-width: 720px) {
    .trust-strip__inner { justify-content: flex-start; }
  }
</style>
