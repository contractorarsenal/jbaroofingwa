---
/**
 * A two-column comparison panel (Metal vs. Shingles, Cleaning vs. Repair,
 * Repair vs. Replacement) — a set of rows, each with a label and the two
 * sides' answers, rather than another paragraph of prose.
 */
interface Row {
  label: string;
  left: string;
  right: string;
}

interface Props {
  leftLabel: string;
  rightLabel: string;
  rows: Row[];
}

const { leftLabel, rightLabel, rows } = Astro.props;
---

<div class="comparison">
  <div class="comparison__head" aria-hidden="true">
    <span></span>
    <span class="comparison__head-col">{leftLabel}</span>
    <span class="comparison__head-col comparison__head-col--accent">{rightLabel}</span>
  </div>
  {rows.map((row) => (
    <div class="comparison__row">
      <span class="comparison__label">{row.label}</span>
      <div class="comparison__cell">
        <span class="comparison__cell-tag">{leftLabel}</span>
        {row.left}
      </div>
      <div class="comparison__cell comparison__cell--accent">
        <span class="comparison__cell-tag">{rightLabel}</span>
        {row.right}
      </div>
    </div>
  ))}
</div>

<style>
  .comparison { border-top: 1px solid var(--color-border); }
  .comparison__head { display: none; }
  .comparison__row {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .comparison__label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .comparison__cell { font-size: 0.9375rem; line-height: 1.55; }
  .comparison__cell-tag {
    display: block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.2em;
  }
  .comparison__cell--accent .comparison__cell-tag { color: var(--color-accent-dark); }

  @media (min-width: 720px) {
    .comparison__head {
      display: grid;
      grid-template-columns: 200px 1fr 1fr;
      gap: var(--space-4);
      padding-bottom: var(--space-3);
      border-bottom: 2px solid var(--color-text);
    }
    .comparison__head-col { font-weight: 800; text-transform: uppercase; font-size: 0.8125rem; letter-spacing: 0.04em; }
    .comparison__head-col--accent { color: var(--color-accent-dark); }
    .comparison__row {
      grid-template-columns: 200px 1fr 1fr;
      gap: var(--space-4);
      align-items: start;
    }
    .comparison__cell-tag { display: none; }
  }
</style>
