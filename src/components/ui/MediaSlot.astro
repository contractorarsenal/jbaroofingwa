---
/**
 * Reusable image slot with a graceful fallback chain:
 *   1. a real image (from CMS/content) — pass via `image`
 *   2. a tasteful branded "roofline" treatment — used automatically when
 *      `image` is empty, so a missing photo never looks broken or unfinished
 *
 * The fallback is intentionally NOT text-labeled in the visible design (no
 * "photography pending" banner) — it's marked as placeholder media only via
 * the `data-placeholder-media` attribute and the accessible `label`, so a
 * screen reader still gets an honest description without the visual
 * looking incomplete. Swap real photography in by passing `image`.
 *
 * Real project photography (anything under /images/projects/.../*.jpg) was
 * pre-optimized by scripts/optimize-project-images into matched -sm/large
 * AVIF + WebP + JPEG siblings — when `image` matches that convention this
 * renders a real <picture> with srcset/sizes instead of a single flat <img>.
 */
interface Props {
  image?: string;
  alt?: string;
  label?: string;
  tone?: 'dark' | 'light';
  class?: string;
  /** Which roofline motif variant to use for visual variety across sections on the same page. */
  variant?: 1 | 2 | 3;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  objectPosition?: string;
}

const {
  image,
  alt = '',
  label = 'JBA Roofing & Remodeling',
  tone = 'dark',
  class: className = '',
  variant = 1,
  loading = 'lazy',
  sizes = '(min-width: 900px) 50vw, 100vw',
  objectPosition,
} = Astro.props;

const isOptimizedProjectPhoto = !!image && /^\/images\/projects\/.+\.jpg$/i.test(image);
const base = isOptimizedProjectPhoto ? image!.slice(0, -4) : null;
const imgStyle = objectPosition ? `object-position: ${objectPosition};` : undefined;
---

{image ? (
  <div class:list={['media-slot', className]}>
    {isOptimizedProjectPhoto ? (
      <picture>
        <source type="image/avif" srcset={`${base}-sm.avif 800w, ${base}.avif 1600w`} sizes={sizes} />
        <source type="image/webp" srcset={`${base}-sm.webp 800w, ${base}.webp 1600w`} sizes={sizes} />
        <img
          src={image}
          srcset={`${base}-sm.jpg 800w, ${base}.jpg 1600w`}
          sizes={sizes}
          alt={alt}
          loading={loading}
          decoding={loading === 'eager' ? 'sync' : 'async'}
          fetchpriority={loading === 'eager' ? 'high' : 'auto'}
          style={imgStyle}
        />
      </picture>
    ) : (
      <img src={image} alt={alt} loading={loading} style={imgStyle} />
    )}
  </div>
) : (
  <div
    class:list={['media-slot', 'media-slot--fallback', `media-slot--${tone}`, className]}
    role="img"
    aria-label={label}
    data-placeholder-media
  >
    <svg class="media-slot__pattern" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <radialGradient id={`ms-grad-${variant}`} cx="50%" cy="38%" r="75%">
          <stop offset="0%" stop-color={tone === 'dark' ? '#202020' : '#eae8e2'} />
          <stop offset="100%" stop-color={tone === 'dark' ? '#080808' : '#eeece6'} />
        </radialGradient>
      </defs>
      <rect width="400" height="400" fill={`url(#ms-grad-${variant})`} />

      {variant === 1 && (
        <>
          <polyline points="-20,240 130,110 280,240" fill="none" stroke="#d19b2a" stroke-width="2" opacity="0.7" />
          <polyline points="60,290 200,155 340,290" fill="none" stroke="#d19b2a" stroke-width="1.5" opacity="0.35" />
          <line x1="0" y1="290" x2="400" y2="290" stroke="#d19b2a" stroke-width="1" opacity="0.25" />
          <line x1="200" y1="290" x2="200" y2="345" stroke="#d19b2a" stroke-width="1" opacity="0.2" />
          <line x1="0" y1="345" x2="400" y2="345" stroke="#d19b2a" stroke-width="1" opacity="0.15" />
        </>
      )}
      {variant === 2 && (
        <>
          <polyline points="0,190 90,190 140,90 190,190 400,190" fill="none" stroke="#d19b2a" stroke-width="2" opacity="0.6" />
          <line x1="140" y1="90" x2="140" y2="20" stroke="#d19b2a" stroke-width="1.5" opacity="0.4" />
          <line x1="0" y1="270" x2="400" y2="270" stroke="#d19b2a" stroke-width="1" opacity="0.22" />
          <line x1="0" y1="330" x2="400" y2="330" stroke="#d19b2a" stroke-width="1" opacity="0.14" />
        </>
      )}
      {variant === 3 && (
        <>
          <polyline points="-20,110 120,110 180,240 400,240" fill="none" stroke="#d19b2a" stroke-width="2" opacity="0.55" />
          <polyline points="220,300 260,200 400,200" fill="none" stroke="#d19b2a" stroke-width="1.5" opacity="0.3" />
          <line x1="0" y1="300" x2="400" y2="300" stroke="#d19b2a" stroke-width="1" opacity="0.2" />
          <line x1="0" y1="350" x2="400" y2="350" stroke="#d19b2a" stroke-width="1" opacity="0.13" />
        </>
      )}
    </svg>
  </div>
)}

<style>
  .media-slot {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 200px;
    overflow: hidden;
  }
  .media-slot picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .media-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media-slot--fallback { background: var(--color-charcoal); }
  .media-slot--light.media-slot--fallback { background: var(--color-bg-alt); }
  .media-slot__pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
