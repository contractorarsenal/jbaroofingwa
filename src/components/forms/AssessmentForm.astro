---
/**
 * The single, shared roof-assessment funnel, used on the /assessment/ page.
 * All submit/validation/photo-upload logic lives here once; hosting pages
 * only supply their own surrounding chrome (heading, layout, background).
 * Submits to Web3Forms.
 */
import { getGlobalSettings } from '@lib/content';

const settings = await getGlobalSettings();

const progressSteps = [
  'What Do You Need Help With?',
  'What Are You Noticing?',
  'Property Details',
  'How Can We Reach You?',
];
---

<div class="assessment-form">
  <div class="assessment-form__progress" role="progressbar" aria-valuemin="1" aria-valuemax="4" aria-valuenow="1" data-progress>
    {progressSteps.map((label, i) => (
      <div class="progress-segment" data-segment={i}>
        <span class="progress-segment__bar" data-segment-bar></span>
        <span class="progress-segment__label">{String(i + 1).padStart(2, '0')}<span class="progress-segment__label-text"> {label}</span></span>
      </div>
    ))}
  </div>

  <form id="assessment-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
    <input type="hidden" name="access_key" value="1ca2a091-176a-4429-a2c2-7510f8daa07e" />
    <input type="hidden" name="subject" value="New Roof Assessment Request, JBA Roofing Website" />
    <input type="hidden" name="from_name" value="JBA Roofing Website" />
    <input type="text" name="company_website" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <!-- STEP 1: ZIP -->
    <fieldset class="step" data-step="1">
      <legend class="step__title">Where is the property?</legend>
      <p class="text-muted step__sub">Just the ZIP code to start.</p>
      <input type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" name="zip" class="step__zip-input" placeholder="98101" required />
      <button type="button" class="btn btn--primary btn--block" data-next>Start</button>
    </fieldset>

    <!-- STEP 2: NEED -->
    <fieldset class="step" data-step="2" hidden>
      <legend class="step__title">What do you need help with?</legend>
      <div class="step__options" data-options="need">
        <button type="button" class="option-card" data-value="replacement">I Need a New Roof</button>
        <button type="button" class="option-card" data-value="repair">I Have a Leak or Damage</button>
        <button type="button" class="option-card" data-value="inspection">I Want a Roof Inspection</button>
        <button type="button" class="option-card" data-value="maintenance">I Need Roof Cleaning / Maintenance</button>
        <button type="button" class="option-card" data-value="unsure">I'm Not Sure</button>
      </div>
      <button type="button" class="btn btn--outline" data-back>Back</button>
    </fieldset>

    <!-- STEP 3: WHAT ARE YOU NOTICING -->
    <fieldset class="step" data-step="3" hidden>
      <legend class="step__title">What are you noticing?</legend>
      <div class="step__options" data-options="context">
        <button type="button" class="option-card" data-value="leak">Leak or Water</button>
        <button type="button" class="option-card" data-value="missing-shingles">Missing or Damaged Shingles</button>
        <button type="button" class="option-card" data-value="moss">Moss or Buildup</button>
        <button type="button" class="option-card" data-value="looks-old">Roof Looks Old</button>
        <button type="button" class="option-card" data-value="storm-damage">Storm Damage</button>
        <button type="button" class="option-card" data-value="other">Other</button>
        <button type="button" class="option-card" data-value="unsure">Not Sure</button>
      </div>
      <button type="button" class="btn btn--outline" data-back>Back</button>
    </fieldset>

    <!-- STEP 4: ROOF AGE -->
    <fieldset class="step" data-step="4" hidden>
      <legend class="step__title">How old is the roof?</legend>
      <p class="text-muted step__sub">A rough estimate is fine.</p>
      <div class="step__options" data-options="roofAge">
        <button type="button" class="option-card" data-value="5-10-years">5 to 10 Years</button>
        <button type="button" class="option-card" data-value="15-20-years">15 to 20 Years</button>
        <button type="button" class="option-card" data-value="20-30-years">20 to 30 Years</button>
        <button type="button" class="option-card" data-value="not-sure">Not Sure</button>
      </div>
      <button type="button" class="btn btn--outline" data-back>Back</button>
    </fieldset>

    <!-- STEP 5: PROPERTY DETAILS (timeline + insurance) -->
    <fieldset class="step" data-step="5" hidden>
      <legend class="step__title">Tell us about the property</legend>
      <p class="step__sub-question">How soon do you need help?</p>
      <div class="step__options" data-options="timeline">
        <button type="button" class="option-card option-card--urgent" data-value="emergency">Emergency, today</button>
        <button type="button" class="option-card" data-value="asap">As soon as possible</button>
        <button type="button" class="option-card" data-value="1-4-weeks">Within 1 to 4 weeks</button>
        <button type="button" class="option-card" data-value="planning">Just planning ahead</button>
      </div>

      <p class="step__sub-question">Is this related to an insurance claim?</p>
      <div class="step__options step__options--inline" data-options="insurance">
        <button type="button" class="option-card option-card--compact" data-value="yes">Yes</button>
        <button type="button" class="option-card option-card--compact" data-value="no">No</button>
      </div>
      <p class="step__error" data-step-error role="alert" hidden></p>
      <div class="step__actions">
        <button type="button" class="btn btn--outline" data-back>Back</button>
        <button type="button" class="btn btn--primary" data-next>Continue</button>
      </div>
    </fieldset>

    <!-- STEP 6: PHOTO UPLOAD (optional) -->
    <fieldset class="step" data-step="6" hidden>
      <legend class="step__title">Add Photos <span class="text-muted">(Optional)</span></legend>
      <p class="text-muted step__sub">Photos can help us understand what you're seeing before we follow up.</p>
      <label class="photo-upload">
        <input type="file" name="photo" accept="image/*" capture="environment" data-photo-input />
        <svg class="photo-upload__icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="13.5" r="3.25" stroke="currentColor" stroke-width="1.6"/></svg>
        <span data-photo-label>Take or Choose a Photo</span>
      </label>
      <p class="photo-upload__error" data-photo-error role="alert" hidden></p>
      <div class="step__actions">
        <button type="button" class="btn btn--outline" data-back>Back</button>
        <button type="button" class="btn btn--primary" data-next>Continue</button>
      </div>
    </fieldset>

    <!-- STEP 7: CONTACT INFO -->
    <fieldset class="step" data-step="7" hidden>
      <legend class="step__title">How should we reach you?</legend>
      <div class="form-field">
        <label for="af-name">Name</label>
        <input id="af-name" type="text" name="name" autocomplete="name" required />
      </div>
      <div class="form-field">
        <label for="af-phone">Phone</label>
        <input id="af-phone" type="tel" name="phone" autocomplete="tel" required />
      </div>
      <div class="form-field">
        <label for="af-email">Email</label>
        <input id="af-email" type="email" name="email" autocomplete="email" required />
      </div>
      <div class="form-field">
        <label for="af-address">Street Address</label>
        <input id="af-address" type="text" name="address" autocomplete="street-address" />
      </div>
      <div class="form-field">
        <label for="af-notes">Anything else we should know? <span class="text-muted">(optional)</span></label>
        <textarea id="af-notes" name="notes" rows="3"></textarea>
      </div>
      <div class="form-field">
        <span>Preferred contact method</span>
        <div class="step__options step__options--inline" data-options="preferredContact">
          <button type="button" class="option-card option-card--compact" data-value="phone">Call</button>
          <button type="button" class="option-card option-card--compact" data-value="text">Text</button>
          <button type="button" class="option-card option-card--compact" data-value="email">Email</button>
        </div>
      </div>
      <button type="submit" class="btn btn--primary btn--block" data-submit>Get My Free Estimate</button>
      <button type="button" class="btn btn--outline" data-back>Back</button>
      <p class="assessment-form__status" data-form-status role="status" aria-live="polite"></p>
    </fieldset>

    <!-- SUCCESS -->
    <div class="step step--outcome" data-step="confirm" role="status" aria-live="polite" hidden>
      <svg class="step--outcome__icon" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
        <path d="M12 20.5l5.2 5.2L28.5 14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <h2 class="step--outcome__heading" tabindex="-1">Request Received</h2>
      <p class="step--outcome__body">
        Thanks. JBA Roofing has received your request. We'll use the
        information you provided to follow up.
      </p>
      <div class="step--outcome__actions">
        <a href="/" class="btn btn--outline">Back to Home</a>
        <a href={`tel:${settings.primaryPhone}`} class="btn btn--primary" data-analytics-event="phone_click" data-analytics-location="assessment_success">Call Now</a>
      </div>
    </div>

    <!-- ERROR -->
    <div class="step step--outcome" data-step="error" role="alert" aria-live="assertive" hidden>
      <h2 class="step--outcome__heading" tabindex="-1">We Couldn't Send Your Request</h2>
      <p class="step--outcome__body">
        Something went wrong while sending your request. Please try again or call JBA Roofing.
      </p>
      <div class="step--outcome__actions">
        <button type="button" class="btn btn--outline" data-retry>Try Again</button>
        <a href={`tel:${settings.primaryPhone}`} class="btn btn--primary" data-analytics-event="phone_click" data-analytics-location="assessment_error">Call Now</a>
      </div>
    </div>
  </form>
</div>

<style>
  /* Different steps have different content heights. A min-height on the
     form itself keeps the card from collapsing/growing dramatically between
     steps, so the page doesn't visually lurch even without auto-scrolling. */
  #assessment-form { min-height: 320px; }
  @media (min-width: 640px) {
    #assessment-form { min-height: 440px; }
  }

  .assessment-form__progress {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .progress-segment { display: flex; flex-direction: column; gap: var(--space-2); }
  .progress-segment__bar {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--color-border-dark, var(--color-border));
    overflow: hidden;
    position: relative;
  }
  .progress-segment__bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease-out);
  }
  .progress-segment.is-complete .progress-segment__bar::after { transform: scaleX(1); }
  .progress-segment__label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 320ms var(--ease-out);
  }
  .progress-segment.is-complete .progress-segment__label { color: var(--color-accent); }
  .progress-segment__label-text { display: none; }
  @media (min-width: 640px) {
    .progress-segment__label-text { display: inline; }
  }

  .step__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .step__sub { margin-bottom: var(--space-5); color: var(--color-text-muted); }
  .step__sub-question { font-weight: 700; margin-top: var(--space-6); margin-bottom: var(--space-3); }
  .step__zip-input {
    display: block;
    width: 100%;
    font-size: var(--step-3);
    font-family: var(--font-display);
    font-weight: 700;
    padding: var(--space-3) var(--space-4);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-5);
    background: var(--color-white);
    color: var(--color-text);
  }
  .step__zip-input:focus { border-color: var(--color-accent); }

  .step__options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .step__options--inline { grid-template-columns: repeat(3, 1fr); max-width: 420px; }

  .option-card {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-4);
    min-height: 64px;
    border: 1.5px solid var(--color-border);
    background: var(--color-white);
    color: var(--color-text);
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out),
                transform 160ms var(--ease-out);
  }
  .option-card--compact { min-height: 48px; padding: var(--space-2); }
  .option-card:hover { border-color: var(--color-accent); }
  .option-card[aria-pressed="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-black);
    transform: scale(1.02);
  }
  .option-card--urgent[aria-pressed="true"] { background: var(--color-urgent); border-color: var(--color-urgent); color: var(--color-white); }

  .form-field { display: flex; flex-direction: column; gap: var(--space-1); font-weight: 600; font-size: var(--step--1); margin-bottom: var(--space-4); }
  .form-field input,
  .form-field textarea {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 400;
    background: var(--color-white);
    color: var(--color-text);
    resize: vertical;
  }
  .form-field input:focus,
  .form-field textarea:focus { border-color: var(--color-accent); }

  .photo-upload {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 140px;
    border: 1.5px dashed var(--color-border);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-5);
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .photo-upload__icon { color: var(--color-accent-dark); }
  .photo-upload input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .photo-upload:has(input:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .photo-upload__error {
    color: var(--color-urgent);
    font-size: var(--step--1);
    font-weight: 600;
    margin-top: calc(var(--space-3) * -1);
    margin-bottom: var(--space-5);
  }

  .step__error {
    color: var(--color-urgent);
    font-size: var(--step--1);
    font-weight: 600;
    margin-top: calc(var(--space-3) * -1);
    margin-bottom: var(--space-4);
  }

  .step__actions { display: flex; gap: var(--space-3); }
  .step__actions .btn { flex: 1; }

  [data-back] { margin-top: var(--space-3); }
  .assessment-form__status { margin-top: var(--space-3); font-weight: 600; font-size: var(--step--1); min-height: 1.2em; }
  .assessment-form__status[data-state="error"] { color: var(--color-urgent); }
  .assessment-form__status[data-state="pending"] { color: var(--color-text-muted); }

  /* Success/error outcome: one centered composition (icon, heading, body,
     buttons all sharing the same centered column), not text-align:center
     applied to a left-aligned block layout — that's what previously left
     the icon looking stranded at the edge while the text centered. */
  .step--outcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    padding-block: clamp(2.75rem, 2.2rem + 2.5vw, 4.5rem) var(--space-6);
  }
  /* [hidden] and .step--outcome are equal-specificity selectors — without
     this, display:flex above wins over the browser's default [hidden]
     {display:none} and both outcome states render at once. */
  .step--outcome[hidden] { display: none; }
  .step--outcome__icon {
    width: 44px;
    height: 44px;
    color: var(--color-accent);
    margin-bottom: var(--space-5);
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .step--outcome__icon { width: 56px; height: 56px; }
  }
  .step--outcome__heading {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2rem, 1.6rem + 1.85vw, 3.25rem);
    line-height: 1.1;
  }
  .step--outcome__body {
    margin-top: var(--space-4);
    max-width: 54ch;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .step--outcome__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    width: 100%;
  }
  .step--outcome__actions .btn {
    width: 100%;
    max-width: 320px;
  }
  @media (min-width: 480px) {
    .step--outcome__actions { width: auto; }
    .step--outcome__actions .btn { width: auto; }
  }

  /* step transition, plays whenever a step goes from hidden to visible */
  @keyframes stepRise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .step:not([hidden]) { animation: stepRise 380ms var(--ease-out) both; }

  [data-submit]:disabled { opacity: 0.65; cursor: wait; }

  @media (prefers-reduced-motion: reduce) {
    .step:not([hidden]) { animation: none; }
    .option-card[aria-pressed="true"] { transform: none; }
    .progress-segment__bar::after { transition: none; }
  }
</style>

<script>
  import { trackEvent } from '@lib/analytics';
  import { submitToWeb3Forms } from '@lib/web3forms';

  type Answers = {
    zip?: string;
    need?: string;
    context?: string;
    roofAge?: string;
    timeline?: string;
    insurance?: string;
    preferredContact?: string;
  };

  const form = document.getElementById('assessment-form') as HTMLFormElement;
  const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'));
  const progressWrap = document.querySelector<HTMLElement>('[data-progress]');
  const segments = Array.from(document.querySelectorAll<HTMLElement>('.progress-segment'));
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  const answers: Answers = {};
  let currentIndex = 0; // index into steps[] (excludes confirm/error)

  // Maps the 7 functional fieldsets onto the 4 visual progress segments.
  const STEP_TO_SEGMENT = [0, 0, 1, 2, 2, 2, 3];

  function updateProgress() {
    const activeSegment = STEP_TO_SEGMENT[currentIndex] ?? 0;
    segments.forEach((seg, i) => seg.classList.toggle('is-complete', i <= activeSegment));
    progressWrap?.setAttribute('aria-valuenow', String(activeSegment + 1));
  }

  // Moves focus to the new step's heading (without scrolling the page —
  // scrollIntoView on every step change was jumping the viewport up/down,
  // forcing the user to manually scroll back to see the new question), and
  // only nudges the page into view if the step is genuinely off-screen.
  function settleOnStep(step: HTMLElement) {
    const heading = step.querySelector<HTMLElement>('.step__title') ?? step.querySelector<HTMLElement>('h2') ?? step;
    if (!heading.hasAttribute('tabindex')) heading.setAttribute('tabindex', '-1');
    heading.focus({ preventScroll: true });

    const rect = step.getBoundingClientRect();
    const completelyOffscreen = rect.bottom <= 0 || rect.top >= window.innerHeight;
    if (completelyOffscreen) {
      step.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function showStep(index: number, { track = true, settle = true } = {}) {
    steps.forEach((step, i) => {
      step.hidden = i !== index;
    });
    currentIndex = index;
    updateProgress();
    if (track) trackEvent('quote_step_completed', { step: String(index + 1) });
    if (settle && steps[index]) settleOnStep(steps[index]);
  }

  function showOutcome(name: 'confirm' | 'error') {
    steps.forEach((step) => (step.hidden = true));
    const outcome = form.querySelector<HTMLElement>(`[data-step="${name}"]`);
    if (outcome) {
      outcome.hidden = false;
      settleOnStep(outcome);
    }
    if (name === 'confirm') segments.forEach((seg) => seg.classList.add('is-complete'));
  }

  function selectSingle(button: HTMLButtonElement, key: keyof Answers, autoAdvance = false) {
    const group = button.closest('[data-options]');
    group?.querySelectorAll('.option-card').forEach((el) => el.setAttribute('aria-pressed', 'false'));
    button.setAttribute('aria-pressed', 'true');
    (answers as Record<string, unknown>)[key] = button.dataset.value;

    if (key === 'timeline' || key === 'insurance') {
      const stepError = steps[4]?.querySelector<HTMLElement>('[data-step-error]');
      if (stepError && answers.timeline && answers.insurance) stepError.hidden = true;
    }

    if (autoAdvance) {
      window.setTimeout(() => goNext(), 200);
    }
  }

  function goNext() {
    if (currentIndex === 0) {
      const zipInput = form.querySelector<HTMLInputElement>('input[name="zip"]');
      if (!zipInput?.reportValidity()) return;
      answers.zip = zipInput.value;
    }
    if (currentIndex === 1) {
      if (!answers.need) return;
    }
    if (currentIndex === 4) {
      const stepError = steps[4]?.querySelector<HTMLElement>('[data-step-error]');
      if (!answers.timeline || !answers.insurance) {
        // A silent, unexplained no-op here is what made this step feel like
        // it needed a second click — show exactly what's missing instead.
        if (stepError) {
          const missing = !answers.timeline && !answers.insurance
            ? 'a timeline and whether this involves an insurance claim'
            : !answers.timeline
              ? 'how soon you need help'
              : 'whether this involves an insurance claim';
          stepError.textContent = `Please select ${missing} above.`;
          stepError.hidden = false;
        }
        return;
      }
      if (stepError) stepError.hidden = true;
    }
    if (currentIndex < steps.length - 1) showStep(currentIndex + 1);
  }

  function goBack() {
    if (currentIndex > 0) showStep(currentIndex - 1);
  }

  // Wire up option-card click handlers for all static groups (need, context, timeline, insurance, preferredContact)
  form.querySelectorAll<HTMLElement>('[data-options]').forEach((group) => {
    const key = group.dataset.options as keyof Answers | undefined;
    if (!key) return;
    group.querySelectorAll<HTMLButtonElement>('.option-card').forEach((btn) => {
      btn.setAttribute('aria-pressed', 'false');
      const autoAdvance = key === 'need' || key === 'context' || key === 'roofAge';
      btn.addEventListener('click', () => selectSingle(btn, key, autoAdvance));
    });
  });

  form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((btn) => btn.addEventListener('click', goNext));
  form.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((btn) => btn.addEventListener('click', goBack));
  form.querySelectorAll<HTMLButtonElement>('[data-retry]').forEach((btn) =>
    btn.addEventListener('click', () => showStep(steps.length - 1, { track: false }))
  );

  // Kept reasonable for a typical phone photo, well under Web3Forms' upload limit.
  const MAX_PHOTO_BYTES = 6 * 1024 * 1024;

  const photoInput = form.querySelector<HTMLInputElement>('[data-photo-input]');
  const photoLabel = form.querySelector<HTMLElement>('[data-photo-label]');
  const photoError = form.querySelector<HTMLElement>('[data-photo-error]');

  function setPhotoError(message: string | null) {
    if (!photoError) return;
    photoError.textContent = message ?? '';
    photoError.hidden = !message;
  }

  photoInput?.addEventListener('change', () => {
    const file = photoInput.files?.[0];
    setPhotoError(null);

    if (!file) {
      if (photoLabel) photoLabel.textContent = 'Take or choose a photo';
      return;
    }

    if (file.size > MAX_PHOTO_BYTES) {
      setPhotoError('That photo is a bit too large. Try one under 6MB, or continue without it.');
      photoInput.value = '';
      if (photoLabel) photoLabel.textContent = 'Take or choose a photo';
      return;
    }

    if (photoLabel) photoLabel.textContent = `${file.name} selected`;
    trackEvent('photo_uploaded', { count: '1' });
  });

  // Pre-fill from query params (?need=repair&symptom=leak), e.g. from the homepage Problem Selector
  const params = new URLSearchParams(window.location.search);
  const preNeed = params.get('need');
  const preSymptom = params.get('symptom');
  let startIndex = 0;
  if (preNeed) {
    const needBtn = form.querySelector<HTMLButtonElement>(`[data-options="need"] [data-value="${preNeed}"]`);
    if (needBtn) {
      answers.need = preNeed;
      needBtn.setAttribute('aria-pressed', 'true');
      if (preSymptom) {
        const symptomBtn = form.querySelector<HTMLButtonElement>(`[data-options="context"] [data-value="${preSymptom}"]`);
        if (symptomBtn) selectSingle(symptomBtn, 'context');
      }
      startIndex = 2;
    }
  }

  const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
  const submitBtnDefaultText = submitBtn?.textContent ?? '';
  let isSubmitting = false;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Guards against a duplicate Web3Forms request from a rapid double
    // click, Enter-plus-click, or a repeated tap while the first request
    // is still in flight — checked first, before any other work.
    if (isSubmitting) return;

    const data = new FormData(form);
    if (data.get('company_website')) return; // honeypot

    const name = String(data.get('name') ?? '');
    const phone = String(data.get('phone') ?? '');
    const email = String(data.get('email') ?? '');

    if (!name || !phone || !email) {
      if (status) {
        status.textContent = 'Please fill in name, phone, and email.';
        status.dataset.state = 'error';
      }
      const firstInvalid = form.querySelector<HTMLInputElement>(
        !name ? '#af-name' : !phone ? '#af-phone' : '#af-email'
      );
      firstInvalid?.focus();
      return;
    }

    isSubmitting = true;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }
    if (status) {
      status.textContent = 'Sending...';
      status.dataset.state = 'pending';
    }

    // Fold the step-by-step answers into the payload sent to Web3Forms
    // alongside the step-6 fields FormData already captured.
    data.set('zip_code', answers.zip ?? '');
    data.set('need', answers.need ?? '');
    data.set('noticing', answers.context ?? '');
    data.set('roof_age', answers.roofAge ?? '');
    data.set('timeline', answers.timeline ?? '');
    data.set('insurance_claim', answers.insurance ?? '');
    data.set('preferred_contact', answers.preferredContact ?? '');

    try {
      const result = await submitToWeb3Forms(data);

      if (result.ok) {
        trackEvent('quote_submitted', { need: answers.need ?? 'unknown', timeline: answers.timeline ?? 'unknown' });
        showOutcome('confirm');
      } else {
        if (status) {
          status.textContent = '';
          status.dataset.state = '';
        }
        showOutcome('error');
      }
    } finally {
      isSubmitting = false;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = submitBtnDefaultText;
      }
    }
  });

  showStep(startIndex, { track: false, settle: false });
</script>
