---
/**
 * Matches the client-supplied review-card screenshot closely: dark
 * charcoal card, subtle 1px border, modest radius, generous padding,
 * Google attribution top-left / gold stars top-right, large muted-gray
 * review text, and the reviewer identity block pushed toward the bottom
 * with real breathing room above it (margin-top: auto), not immediately
 * following the quote.
 */
import { getEntry, type CollectionEntry } from 'astro:content';

interface Props {
  review: CollectionEntry<'reviews'>;
  'data-reveal'?: string;
}

const { review, ...rest } = Astro.props;
const { data } = review;
const service = data.service ? await getEntry(data.service) : undefined;

const sourceLabel = data.reviewSource === 'google' ? 'Google Review' : `${data.reviewSource} Review`;
---

<figure class="review-card" {...rest}>
  <div class="review-card__head">
    <span class="review-card__source">
      {data.reviewSource === 'google' && (
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.09A6.6 6.6 0 0 1 5.5 12c0-.73.12-1.44.34-2.09V7.06H2.18A11 11 0 0 0 1 12c0 1.78.43 3.46 1.18 4.94l3.66-2.85z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.06l3.66 2.85C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
      )}
      {sourceLabel}
    </span>
    <div class="review-card__stars" aria-label={`${data.rating} out of 5 stars`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <svg width="15" height="15" viewBox="0 0 20 20" fill={i < data.rating ? 'currentColor' : 'none'} stroke="currentColor" aria-hidden="true">
          <path stroke-width="1.2" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L10 1.5z"/>
        </svg>
      ))}
    </div>
  </div>
  <blockquote class="review-card__text">{data.reviewText}</blockquote>
  <figcaption class="review-card__meta">
    <cite class="review-card__name">{data.customerName}</cite>
    {data.city && <span class="text-muted review-card__city"> · {data.city}</span>}
    {service && <span class="review-card__tag">{service.data.title}</span>}
  </figcaption>
</figure>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    padding: 44px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    background: #1c1c1c;
    height: 100%;
    transition: border-color 220ms var(--ease-out);
  }
  .review-card:hover { border-color: var(--color-accent); }

  .review-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .review-card__source {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #d8d8d8;
  }
  .review-card__stars { display: flex; gap: 3px; color: var(--color-accent); flex-shrink: 0; }

  .review-card__text {
    margin-top: 26px;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #aaaaaa;
  }

  .review-card__meta {
    margin-top: auto;
    padding-top: 40px;
  }
  .review-card__name {
    display: block;
    font-style: normal;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text-inverse);
  }
  .review-card__city { font-size: 0.875rem; }
  .review-card__tag {
    display: block;
    margin-top: 0.4em;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (max-width: 1023px) {
    .review-card { padding: 38px; }
  }
  @media (max-width: 640px) {
    .review-card { padding: 28px; }
    .review-card__text { margin-top: 20px; font-size: 1rem; }
    .review-card__meta { padding-top: 28px; }
    .review-card__head { gap: var(--space-2); }
  }
  @media (max-width: 340px) {
    .review-card__head { flex-direction: column; align-items: flex-start; gap: 0.5em; }
  }
</style>
