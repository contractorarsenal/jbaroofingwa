---
import { getEntry, type CollectionEntry } from 'astro:content';

interface Props {
  review: CollectionEntry<'reviews'>;
  'data-reveal'?: string;
}

const { review, ...rest } = Astro.props;
const { data } = review;
const service = data.service ? await getEntry(data.service) : undefined;

const sourceLabel = data.reviewSource === 'google' ? 'Google Review' : `${data.reviewSource} Review`;
---

<figure class="review-card" {...rest}>
  <div class="review-card__head">
    <span class="review-card__source">
      {data.reviewSource === 'google' && (
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.26 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.84 14.09A6.6 6.6 0 0 1 5.5 12c0-.73.12-1.44.34-2.09V7.06H2.18A11 11 0 0 0 1 12c0 1.78.43 3.46 1.18 4.94l3.66-2.85z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.06l3.66 2.85C6.71 7.31 9.14 5.38 12 5.38z"/></svg>
      )}
      {sourceLabel}
    </span>
    <div class="review-card__stars" aria-label={`${data.rating} out of 5 stars`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <svg width="14" height="14" viewBox="0 0 20 20" fill={i < data.rating ? 'currentColor' : 'none'} stroke="currentColor" aria-hidden="true">
          <path stroke-width="1.2" d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6L10 1.5z"/>
        </svg>
      ))}
    </div>
  </div>
  <blockquote class="review-card__text">{data.reviewText}</blockquote>
  <figcaption class="review-card__meta">
    <cite class="review-card__name">{data.customerName}</cite>
    {data.city && <span class="text-muted"> · {data.city}</span>}
    {service && <span class="review-card__tag">{service.data.title}</span>}
  </figcaption>
</figure>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    background: var(--color-charcoal);
    height: 100%;
    transition: border-color 220ms var(--ease-out);
  }
  .review-card:hover { border-color: var(--color-accent); }
  .review-card__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .review-card__source {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-inverse-muted);
  }
  .review-card__stars { display: flex; gap: 2px; color: var(--color-accent); flex-shrink: 0; }
  .review-card__text {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-inverse-muted);
    flex: 1;
  }
  .review-card__meta { margin-top: auto; }
  .review-card__name { font-weight: 700; font-style: normal; color: var(--color-text-inverse); }
  .review-card__tag {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
</style>
