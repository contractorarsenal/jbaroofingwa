---
import '@fontsource-variable/inter';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@styles/global.css';
import Seo from '@components/seo/Seo.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import StickyMobileCTA from '@components/global/StickyMobileCTA.astro';
import CookieNotice from '@components/global/CookieNotice.astro';
import { getGlobalSettings } from '@lib/content';
import { buildLocalBusinessSchema } from '@lib/schema';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | (Record<string, unknown> | null)[] | null;
  hideStickyCta?: boolean;
}

const { title, description, ogImage, noindex, jsonLd, hideStickyCta = false } = Astro.props;

const settings = await getGlobalSettings();
const siteUrl = Astro.site?.toString() ?? 'https://jbaroofpro.com';
const localBusinessSchema = buildLocalBusinessSchema(settings, siteUrl);
const combinedJsonLd = [localBusinessSchema, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];

// GA4/GTM only load on production builds (never on `astro dev`/localhost)
// and only when an ID is actually configured. Cloudflare Pages
// preview-branch deploys still run a production build, so they're tracked
// too for now — deliberately not excluded yet, per the current "keep it
// practical while we're still testing deployment" guidance. Revisit once
// the custom domain is live if preview traffic needs its own filter.
const gaEnabled = Boolean(settings.analyticsId) && import.meta.env.PROD;
const gtmEnabled = Boolean(settings.gtmContainerId) && import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={settings.favicon} type="image/svg+xml" />
    <meta name="theme-color" content="#080808" />
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
      // Explicit, defensive: this is already the browser default for a
      // traditional multi-page site like this one (no client router, no
      // View Transitions), but setting it explicitly guards against a
      // regression if either is ever added later. Never force-scroll on
      // load or on back/forward navigation, let the browser restore the
      // visitor's scroll position natively.
      if ('scrollRestoration' in history) history.scrollRestoration = 'auto';
    </script>
    <Seo title={title} description={description} ogImage={ogImage} noindex={noindex} jsonLd={combinedJsonLd} />

    {gaEnabled && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${settings.analyticsId}`}></script>
        <script define:vars={{ gaId: settings.analyticsId, clarityId: settings.clarityProjectId }} is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;

          // Consent Mode default — analytics_storage denied until the
          // visitor accepts, or immediately granted for a returning visitor
          // who already chose "Accept Analytics" in the cookie notice. We
          // are not installing Google Ads, so the ad_* signals stay denied
          // unconditionally. This same dataLayer is shared with GTM below,
          // so any consent-aware tags configured there see this too.
          var storedConsent = null;
          try {
            storedConsent = localStorage.getItem('jba_cookie_consent');
          } catch (e) {}
          var analyticsGranted = storedConsent === 'analytics';

          gtag('consent', 'default', {
            analytics_storage: analyticsGranted ? 'granted' : 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });

          gtag('js', new Date());
          gtag('config', gaId);

          // Returning visitor who already accepted analytics — start
          // Clarity on this page load too, not just after a fresh click.
          // Never on localhost, matching the GA4 dev-traffic guard above.
          var isLocalhost = /^(localhost|127\.0\.0\.1)$/.test(window.location.hostname);
          if (analyticsGranted && clarityId && !isLocalhost && !window.clarity) {
            (function (c, l, a, r, i, t, y) {
              c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
              t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
              y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
            })(window, document, 'clarity', 'script', clarityId);
          }
        </script>
      </>
    )}

    {gtmEnabled && (
      <script define:vars={{ gtmId: settings.gtmContainerId }} is:inline>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}
  </head>
  <body class={hideStickyCta ? '' : 'has-sticky-cta'}>
    {gtmEnabled && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${settings.gtmContainerId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        ></iframe>
      </noscript>
    )}
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!hideStickyCta && <StickyMobileCTA />}
    <CookieNotice />

    <script>
      import { bindAnalyticsClicks } from '@lib/analytics';
      import { initMotion } from '@lib/motion';
      bindAnalyticsClicks();
      initMotion();
    </script>

    <style is:global>
      body.has-sticky-cta {
        padding-bottom: 56px;
      }
      @media (min-width: 1080px) {
        body.has-sticky-cta { padding-bottom: 0; }
      }
    </style>
  </body>
</html>
