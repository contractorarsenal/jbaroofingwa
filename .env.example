# Names only — never put real values in this file. Copy the ones you need
# into Cloudflare Pages → Settings → Environment variables (scoped to
# Production and/or Preview as appropriate), or into a local .dev.vars file
# for `wrangler pages dev` (both .env* and .dev.vars are gitignored).
#
# See CLIENT-CONTENT-NEEDED.md and DEPLOYMENT.md for what each one does and
# whether it's required.

# --- Lead delivery (functions/api/lead.ts) — optional, but needed for leads
#     to actually reach anyone. Without these, submissions still succeed and
#     are logged server-side, but no one is notified. ---
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=

# --- Canonical site URL override (astro.config.mjs) — optional. Leave unset
#     on Preview so it falls back to Cloudflare's own CF_PAGES_URL. Set only
#     on the Production environment once the real domain is live. ---
SITE_URL=
